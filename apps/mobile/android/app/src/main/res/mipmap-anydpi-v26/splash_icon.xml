<?xml version="1.0" encoding="utf-8"?>
<!--
  The Android 12+ system splash icon, as an adaptive icon.

  The foreground is a feathered cut of the approved splash artwork's own
  centre circle, generated by scripts/content/build_app_icons.py from the same
  file as the launch bitmaps; the background is transparent so the system
  paints it on `windowSplashScreenBackground`, which is the artwork's ground.
  Adaptive rather than a plain bitmap because of how the system sizes the two:
  a bitmap is drawn small, an adaptive icon at 240dp masked to its 66/108
  circle. See the note on the splash icon in build_app_icons.py and
  scripts/check-native-splash.py, which proves the layer is wordless and
  mark-free in the sources and in the delivered package.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@android:color/transparent" />
    <foreground android:drawable="@mipmap/splash_icon_layer" />
</adaptive-icon>

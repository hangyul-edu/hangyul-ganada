<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:localeConfig="@xml/locales_config"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!--
      Permissions.

      INTERNET only, and it is a normal (non-dangerous) permission the user is
      never asked about. Capacitor's WebView bridge needs it to serve the
      bundled app over its internal https origin; nothing in the app makes a
      network request, and the release binary has been audited for it.

      This app now asks for **nothing else**, and there is no permission the
      learner is ever prompted for.

      POST_NOTIFICATIONS, RECEIVE_BOOT_COMPLETED, WAKE_LOCK and the removal of
      SCHEDULE_EXACT_ALARM were all here for the daily study reminder, which has
      been removed — see `apps/web/src/pages/MyPage.tsx`. They arrived with
      `@capacitor/local-notifications`, that dependency is gone, and with it go
      the plugin's three broadcast receivers and its boot receiver. That last
      point is what settles the upgrade question: an alarm already scheduled by
      an older build is delivered to `TimedNotificationPublisher`, and after
      this release there is no such receiver in the package for the system to
      deliver it to, so a pending reminder is dropped rather than orphaned. The
      boot receiver that used to re-register alarms after a restart is gone too,
      so nothing survives a reboot either.

      Deliberately NOT requested, because no implemented feature needs them:
      notifications, alarms, location, contacts, microphone, camera, phone, SMS,
      storage.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      A touchscreen is how you write Hangul, but not having a stylus or a
      multi-touch panel is no reason to hide the app from a device.
    -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!--
      `android:screenOrientation="portrait"` above makes the build tools infer a
      *required* portrait feature, which would hide the app from Chromebooks and
      from tablets that report only landscape. Declaring it not-required undoes
      that inference. The activity still prefers portrait on a phone; large
      screens ignore the request entirely from Android 16 onwards, which is the
      behaviour we want on a tablet anyway.
    -->
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />
</manifest>

{
  "name": "@hangyul-ganada/mobile",
  "version": "1.0.2",
  "private": true,
  "description": "Native Android and iOS shells for Hangyul ganada.",
  "scripts": {
    "sync": "npm run build --workspace @hangyul-ganada/web && cap sync",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "build:android:debug": "cd android && ./gradlew assembleDebug",
    "build:android:release": "cd android && ./gradlew bundleRelease assembleRelease",
    "lint:android": "cd android && ./gradlew lint"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0"
  }
}

ρι","Έπιασα ένα ψάρι.",null],["ικανοποιώ ένα αίτημα","Μου έκαναν τη χάρη.",null],["αποτυγχάνω","Απέτυχα στην πρώτη εξέταση.",null],["μετανιώνω","Θα το μετανιώσετε αργότερα.",null],["συσσωρεύομαι, στοιβάζομαι","Μαζεύτηκε πολύ χιόνι.",null],["είμαι μελαγχολικός","Όταν βρέχει, μελαγχολώ.",null],["ακριβώς","Θα βρεθούμε στις τρεις ακριβώς.",null],["ο τόπος του συμβάντος","Πήγα στον τόπο του συμβάντος.",null],["είμαι ολόγεμος","Το δωμάτιο είναι γεμάτο γέλια.",null],["κάθε χρόνο","Ταξιδεύω κάθε χρόνο.",null],["πιάνω φιλία, τα φτιάχνω","Έκανα έναν καινούριο φίλο.",null],["παρακολουθώ στενά","Παρακολουθούμε στενά την κατάσταση.",null],["ενέργεια","Εξοικονομούμε ενέργεια.",null],["είμαι ελεύθερος","Η ψυχή μου νιώθει ελεύθερη.",null],["είμαι ακριβής","Το ρολόι είναι ακριβές.",null],["εναντιώνομαι, αντιτίθεμαι","Αντιτίθεμαι σε εκείνο το σχέδιο.",null],["καταγωγή, ο τόπος προέλευσης","Κατάγομαι από το Πουσάν.",null],["ατενίζω","Ατένιζα τη θάλασσα.",null],["βράζω χυλό","Βράζω χυλό από ρύζι.",null],["ασφάλιση","Έκανα ασφάλεια.",null],["επιλέγω","Επιλέξτε μόνο ένα.",null],["θρησκεία","Μιλήσαμε για τη θρησκεία.",null],["κλίμακα","Η εκδήλωση μεγάλωσε σε κλίμακα.",null],["πρέσβης","Ο πρέσβης ήρθε στην Κορέα.",null],["ελέγχω προσεκτικά","Κοίταξα προσεκτικά γύρω μου.",null],["είμαι ζεστός και αναπαυτικός","Το πάπλωμα είναι πολύ ζεστό και αναπαυτικό.",null],["καλυτερεύω","Η υγεία μου βελτιώθηκε.",null],["επίτηδες","Δεν το έκανα επίτηδες.",null],["για την ακρίβεια, βασικά","Βασικά, ούτε εγώ το ήξερα.",null],["δείχνω, δηλώνω","Το βέλος δείχνει την κατεύθυνση.",null],["εργασία, έργο","Η δουλειά τελείωσε.",null],["προς τα εκεί","Πηγαίνετε προς τα εκεί, παρακαλώ.",null],["δαχτυλικό αποτύπωμα","Στο ποτήρι έμεινε ένα δαχτυλικό αποτύπωμα.",null],["εν τέλει, επιτέλους","Επιτέλους φτάσαμε.",null],["χειροτερεύω","Η όρασή μου χειροτέρεψε.",null],["είμαι επείγων, βιαστικός","Η δουλειά είναι επείγουσα.",null],["τα γαλλικά","Θέλω να μάθω γαλλικά.",null],["συγκρίνω","Σύγκρινα τις τιμές.",null],["είμαι δ
ές.",null],["επιχείρηση, στρατηγική","Καταστρώσαμε μια στρατηγική.",null],["καταρρέω","Ο τοίχος κατέρρευσε.",null],["ισπανικά","Μαθαίνω ισπανικά.",null],["οκέι","Οκέι, ας το κάνουμε έτσι.",null],["γίγαντας","Στην ιστορία εμφανίζεται ένας γίγαντας.",null],["θεραπεύω","Θεράπευσαν την πληγή.",null],["αλλιώς","Δεν υπάρχει άλλος τρόπος.",null],["ηρεμία","Ύστερα από πολλή ώρα ξαναβρήκα την ηρεμία μου.",null],["χωρίς άδεια","Μην μπαίνετε χωρίς άδεια.",null],["ύψος","Μετράω το ύψος μου.",null],["χαμένο παιδί","Ψάχνουν ένα χαμένο παιδί.",null],["έτσι κι αλλιώς","Έτσι κι αλλιώς αργήσαμε.",null],["αυξάνω κάτι","Αύξησα τον χρόνο εξάσκησης.",null],["είμαι αδυσώπητα επίμονος","Εκείνος ο αθλητής είναι πραγματικά αδυσώπητος.",null],["ολοκλήρωση","Η εργασία ολοκληρώθηκε.",null],["όπως και να το κάνουμε","Όπως και να το κάνουμε, σήμερα δεν γίνεται.",null],["αρχικό στάδιο","Στην αρχή ήταν δύσκολα.",null],["φοβάμαι κάτι","Μη φοβάστε.",null],["ξεχειλίζω","Το νερό ξεχείλισε από το ποτήρι.",null],["ζητώ","Ζήτησα βοήθεια.",null],["το ανώτατο όριο","Το πολύ μέχρι δέκα άτομα.",null],["περιλαμβάνω","Με τα μεταφορικά, κάνει τριάντα χιλιάδες γουόν.",null],["είναι κρίμα","Είναι κρίμα να πεταχτεί.",null],["ντρέπομαι","Ντρέπομαι που έκανα λάθος.",null],["μόλυνση","Αποτρέπουμε τη μόλυνση.",null],["μπουσουλάω","Το μωρό μπουσουλάει στο δωμάτιο.",null],["με κυνηγούν","Με κυνηγάει ο χρόνος.",null],["τουλάχιστον","Χρειάζονται τουλάχιστον δύο μέρες.",null],["ιατρική","Σπουδάζω ιατρική.",null],["διακλάδωση","Ο δρόμος χωρίζεται σε δύο.",null],["εκτόξευση","Είδα την εκτόξευση του πυραύλου.",null],["μαρινάρομαι, παστώνομαι","Το λάχανο παστώθηκε καλά.",null],["όχι και τόσο","Το δωμάτιο δεν είναι και τόσο ζεστό.",null],["φάντασμα","Άκουσα μια ιστορία με φαντάσματα.",null],["είμαι αυστηρός","Ο δάσκαλος είναι αυστηρός.",null],["αφαίρεση","Η αφαίρεση του λεκέ είναι δύσκολη.",null],["υποχρέωση προς κάποιον","Σας έχω υποχρέωση.",null],["είμαι μισοψημένος, άγουρος","Το ρύζι έμεινε μισοβρασμένο.",null],["αρμοδιότητα,
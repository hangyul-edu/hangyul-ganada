ull],["புரிந்துகொள்","ஒருவரையொருவர் நன்றாகப் புரிந்துகொள்கிறோம்.",null],["ஏற்படுத்து","விசையை ஏற்படுத்தினேன்.",null],["விஸ்கி","கொஞ்சம் விஸ்கி அருந்தினேன்.",null],["வெற்றிகொள்","பயத்தை வெற்றிகொண்டேன்.",null],["இரவு முழுவதும்","இரவு முழுவதும் படித்தேன்.",null],["கண்டறி","காரணத்தைக் கண்டறிந்தேன்.",null],["சுவரொட்டி","சுவரில் சுவரொட்டி ஒட்டினேன்.",null],["அறுவை சிகிச்சைப் பிரிவு","அறுவை சிகிச்சைப் பிரிவில் பரிசோதனை செய்தேன்.",null],["முதலில்","முதலில் அமருங்கள்.",null],["கேட்டு வா","தூரத்திலிருந்து இசை கேட்கிறது.",null],["சிந்து","பாலைச் சிந்திவிட்டேன்.",null],["ஊசி","ஊசி போட்டுக்கொண்டேன்.",null],["விறகு வெட்டு","விறகு வெட்டுகிறேன்.",null],["குழு","குழுக்களாகப் பிரிவோம்.",null],["காதலர்","உங்களுக்குக் காதலர் இருக்கிறாரா?",null],["தரையிறங்கு","விமானம் பத்திரமாகத் தரையிறங்கியது.",null],["நினைவுகூர்","ஹங்குல் நாளை நினைவுகூர்கிறோம்.",null],["மகத்தானதாக இரு","இது ஒரு மகத்தான படைப்பு.",null],["தனிநபர்","தனிநபர் தகவலைப் பாதுகாக்கிறோம்.",null],["தொடர்பு","எனக்கும் இதற்கும் தொடர்பில்லை.",null],["இதமாக இரு","இலையுதிர்கால மாலைகள் இதமாக இருக்கின்றன.",null],["இயக்கம்","இயங்கவில்லை.",null],["உறுதியாக","உறுதியாக நினைவிருக்கிறது.",null],["சீருடை","வீரர்கள் புதிய சீருடை அணிந்தார்கள்.",null],["இருப்பு","அது இருப்பதே எனக்குத் தெரியாது.",null],["எச்சரிக்கை","எச்சரிக்கையைப் புறக்கணிக்காதீர்கள்.",null],["ஏனெனில்","செல்லவில்லை, ஏனெனில் உடல்நலம் சரியில்லை.",null],["ஒவ்வொரு முறையும்","ஒவ்வொரு முறையும் தாமதமாக வருவதற்கு மன்னிக்கவும்.",null],["கூவு","உரக்கக் கூவினேன்.",null],["ஆறுதல்","நண்பர் எனக்கு ஆறுதல் அளித்தார்.",null],["மிகவும்","மிகவும் விசாலமாக இருக்கிறது.",null],["உடை","உடை மிகவும் சிறப்பாக இருக்கிறது.",null],["அகற்று","கறையை அகற்றினேன்.",null],["ஒரு கோப்பை அருந்து","சேர்ந்து ஒரு கோப்பை அருந்தலாமா?",null],["உருண்டு செல்","பந்து அந்தப் பக்கம் உருண்டு சென்றது.",null],["பணி","பணி நேரம் நீளமாக இருக்கிறது.",null],["சேதம்","சேதம் பெரியதாக இருந்தது.",null],["விற்பனை","கடந்த மாதம் விற்பனை உயர்ந்தது.",null],["அள","உயரத்தை அளக்கிறேன்.",null],["இயக்குநர்","இயக்குநர் ஒரு படம் எடுத்தார்.",null],["திருத்தம்","திருத்தம் தேவை.",null],["சிக்கனமாகப் பயன்படுத்து","தண்ணீரைச் சிக்கனமாகப் பயன்படுத்துகிறேன்.",null],["சாதி","இறுதியாகச் சாதித்தேன்.",null],["கட்டாயம்","கட்டாயம் காப்பாற்றுவேன்.",null],["தானாகவே","கதவு தானாகவே மூடிக்கொண்டது.",null],["கவனம் குவி","படிப்பில் கவனம் குவிக்கிறேன்.",null],["ரத்து செய்","முன்பதிவை ரத்து செய்தேன்.",null],["கேட்டு விளங்கு","நான் கேட்டு விளங்கவில்லை.",null],["பாத்திரம்","நாடகத்தில் அரசன் பாத்திரம் ஏற்றேன்.",null],["கவனித்து ஆராய்","நட்சத்திரங்களைக் கவனித்தேன்.",null],["பதில் சொல்","கேள்விக்குப் பதில் சொன்னேன்.",null],["ஓரளவு","விளக்கம் ஓரளவு கடினமாக இருந்தது.",null],["கருவுற்ற நிலை","என் அக்கா கருவுற்றிருக்கிறார்.",null],["அவ்வப்போது","அவ்வப்போது பழைய நினைவுகள் வருகின்றன.",null],["நிரப்பு","கோப்பையைத் தண்ணீரால் நிரப்பினேன்.",null],["அமைப்பு","அமைப்பு சிக்கலானது.",null],["அழி","எழுத்தை அழித்தேன்.",null],["பிசைந்து உருவாக்கு","கொழுக்கட்டை பிடிக்கிறேன்.",null],["துறை","வேறு துறைக்கு மாறினேன்.",null],["ஓய்வாக இரு","இன்று மதியம் ஓய்வாக இருக்கிறேன்.",null],["பாதுகாத்துக்கொடு","குடும்பத்தைப் பாதுகாக்க விரும்புகிறேன்.",null],["குணமாதல்","குணமாவது விரைவாக இருக்கிறது.",null],["கூடுதல்","இன்னும் கொஞ்சம் சாதம் கொடுங்கள்.",null],["தலைவர்","அவர் அணியின் தலைவர்.",null],["ஒப்புக்கொள்","நானும் ஒப்புக்கொள்கிறேன்.",null],["மறந்து போ","சந்திப்பை மறந்துவிட்டேன்.",null],["ஐயோ பாவம்","ஐயோ பாவம், ரொம்ப வலித்திருக்கும்.",null],["சதவீதம்","பத்து சதவீதம் மட்டுமே மிச்சம்.","பேச்சு கொரியத்தில் சதவீதத்துக்கு 프로 பயன்படுகிறது; எழுத்தில் 퍼센트 என எழுதப்படுகிறது. அதே மூன்று எழுத்துகள் தொழில்முறை வீரரையும் (프로 선수), 프로그램் என்பதன் சுருக்கமாகத் தொலைக்காட்சி நிகழ்ச்சியையும் குறிக்கும்."],["திருப்பிக் கொடு","புத்தகத்தைத் திருப்பிக் கொடுத்தேன்.",null],["ஆண்டு ஊதியம்","ஆண்டு ஊதியம் சற்று உயர்ந்தது.",null],["வெளிவெளி","பூமிக்கு அப்பால் உயிர்களைத் தேடுகிறார்கள்.",null],["ஓட்டமாகப் பார்","ஆவணங்களை வேகமாக ஓட்டமாகப் பார்த்தேன்.",null],["புயல்","புயல் கடந்து சென்றது.",null],["படைப்பிரிவு","படைப்பிரிவுக்குத் திரும்பினார்கள்.",null],["பிடுங்கு","பல்லைப் பிடுங்கினேன்.",null],["அண்ணா","அண்ணா, வாருங்கள்.",null],["பேய்","பேய்க் கதைகள் பயமாக இருக்கின்றன.",null],["எப்படியிருந்தாலும்","எப்படியிருந்தாலும் முடிந்தது.",null],["பொதுவாக","பொதுவாகப் பயன்படுத்தப்படும் சொற்றொடர்.",null],["சரி, தெரியவில்லை","சரி, எனக்கு நன்றாகத் தெரியவில்லை.",null],["எப்படியும்","எப்படியும் நன்றி.",null],["அப்படி","அப்படிச் செய்யலாம்.",null],["மொழிபெயர்ப்பு","மொழிபெயர்ப்பு கடினம்.",null],["மிக அதிகமாக","உங்களைச் சந்தித்ததில் மிகவும் மகிழ்ச்சி.",null],["நிமிர்ந்து பார்","வானத்தை நிமிர்ந்து பார்த்தேன்.",null],["ஓடிப்போ","பூனை ஓடிப்போய்விட்டது.",null],["சண்டையிடு","தம்பியுடன் அடிக்கடி சண்டையிடுகிறேன்.",null],["விடுபடு","ஆபத்திலிருந்து அரிதாக விடுபட்டேன்.",null],["நுண்மையாக இரு","மணல் மிகவும் நுண்மையாக இருக்கிறது.",null],["நடுங்கு","குளிரால் நடுங்குகிறேன்.",null],["ஆயுதம்","ஆயுதத்தைக் கீழே வையுங்கள்.",null],["அனுப்பு","கடிதத்தை அனுப்பினேன்.",null],["பொருந்து","அந்த ஆடை உங்களுக்கு நன்றாகப் பொருந்துகிறது.",null],["எரிவாயு","எரிவாயுவை அணைத்தேன்.",null],["மாறுபடு","சூழல் மாறிவிட்டது.",null],["ரொம்ப","ரொம்ப சுவாரசியமாக இருக்கிறது.",null],["வேட்டை","பழங்காலத்தில் வேட்டையாடினார்கள்.",null],["கொத்து","கோழி தரையைக் கொத்துகிறது.",null],["மூச்சு விடு","மெதுவாக மூச்சு விடுங்கள்.",null],["சோல்லால்","சோல்லால் பண்டிகையில் குடும்பம் ஒன்று கூடுகிறது.",null],["ஒரு பகுதி","ஒரு பகுதியை மட்டும் படித்தேன்.",null],["கழற்று","பெயர்ச் சீட்டைக் கழற்றினேன்.",null],["கனவு காண்","பாடகராக வேண்டும் என்று கனவு காண்கிறேன்.",null],["நின்று போ","மழை நின்றுவிட்டது.",null],["மறுத்துவிடு","வேண்டுகோளை மறுத்துவிட்டேன்.",null],["எல்லை","என் எல்லையைத் தாண்ட விரும்புகிறேன்.",null],["தாக்குதல்","தாக்குதலைத் தடுத்தோம்.",null],["நிஜம்","நிஜத்திலிருந்து மிகவும் வேறுபட்டிருந்தது.",null],["நெருங்கி வா","குளிர்காலம் நெருங்கி வருகிறது.",null],["பண்டைக் காலம்","பண்டைக் காலத்து ஓவியங்கள் எஞ்சியிருக்கின்றன.",null],["சோதனை","ஒரு சோதனை எழுதினேன்.",null],["பாதுகாத்து வை","என் சாமான்களைப் பாதுகாத்து வையுங்கள்.",null],["நல்ல வேளை","மழை நின்றது நல்ல வேளை.",null],["சுவையற்றதாக இரு","இந்தக் குழம்பு சுவையற்றது.",null],["நடைமுறை","நடைமுறை சற்று 
айну відповідь.",null],["опинитися замкненим","Я застряг у ліфті.",null],["сплачувати","Я заплатив карткою.",null],["нізащо","Я нізащо не забуду.",null],["народження","Ми відсвяткували народження дитини.",null],["завершення","Завершення гарне.",null],["ага","Ага, тепер зрозумів.",null],["відчувати гордість","Побачивши результат, я відчув гордість.",null],["бігти слідом","Цуценя весь час бігло слідом.",null],["настільки","Це настільки складно.",null],["людство","Ми вивчаємо історію людства.",null],["поводитися","Мій молодший брат поводиться чемно.",null],["галасувати","Не галасуйте, будь ласка, у класі.",null],["обманювати","Будь ласка, не обманюйте людей.",null],["як заманеться","Обирайте, як заманеться.",null],["завдання","Я виконав завдання.",null],["керувати","Я керую невеликою крамницею.",null],["твердий","Лід твердий.",null],["розширення","Вони розширили коло тих, хто отримує підтримку.",null],["невістка","Невістка прийшла з візитом.",null],["озиратися","Я озирнувся на минуле.",null],["кілька","Прийшло лише кілька людей.",null],["величезний успіх","Цей фільм — величезний успіх.",null],["геть увесь","Геть усе вкрито снігом.",null],["жаль","Ми висловлюємо глибокий жаль з приводу цієї справи.","Слово, до якого вдається уряд чи компанія. 유감을 표하다 близьке до *висловити жаль*: воно визнає, що щось пішло не так, але не є вибаченням, і корейський читач чує цю дистанцію."],["наречений","Наречений усміхається.",null],["скручувати","Я скручую нитку.",null],["чуття ситуації","Він швидко зчитує ситуацію.",null],["вшановувати","Ми вшановуємо досягнення.",null],["величезний","Популярність величезна.",null],["псуватися","Молоко зіпсувалося.",null],["графік","Я подивився графік.",null],["сумувати","Не сумуйте, будь ласка, надто.",null],["злякатися","Я перелякався звуку.",null],["молода людина","Молодих людей багато.",null],["збиратися","На очі навернулися сльози.",null],["зіпсувати","Я завалив іспит.",null],["досконалий","Підготовка досконала.",null],["підходити","Я тихо підійшо
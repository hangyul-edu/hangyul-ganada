у","Я маю попереду іспит.",null],["пробиватися","Пробилися нові паростки.",null],["бути зачарованим","Я був зачарований краєвидом.",null],["подужчати","Вітер подужчав.",null],["заспокоювати","Я заспокоюю дитину, що плаче.",null],["розмахувати","Вони розмахували палицею.",null],["бути єдиним","Це єдиний спосіб.",null],["душевний","Душевно важко.",null],["чинити","Щороку чинять той самий обряд.",null],["навіть","Навіть молодший брат запізнився.",null],["утриматися","Утримайтеся від телефонних розмов.",null],["виштовхнути ногою","Вони виштовхнули двері ногою і вийшли.",null],["стримувати","Їхні очі стримували сльози.",null],["що більше то краще","З інформацією так: що більше, то краще.","Дослівно \"багато, багато, що більше то краще\". Про те, чого не буває забагато, — інформація, помічні руки, вправляння."],["загинути","В аварії загинула одна людина.",null],["фактично","Фактично все скінчилося.",null],["зрадити","Не зраджуйте друга.",null],["бути непосильним","Одному це непосильно.",null],["руйнувати","Не руйнуйте природу.",null],["вивісити","Вони вивісили вивіску.",null],["бути марним","Зусилля не було марним.",null],["померти","Він помер в аварії.",null],["зотліти","Дерево зотліло.",null],["триматися за руки","Я йду, тримаючись за руку з дитиною.",null],["завалити на себе","Я завалив роботу на себе самого.",null],["бути жалюгідним","Заблукалий пес жалюгідний.",null],["повторювати про себе","Я кілька разів повторив ім'я про себе.",null],["усунути","Я усунув пляму.",null],["пропустити","Читаючи, я пропустив рядок.",null],["відкритися","Я відкрився про свої тривоги.",null],["що занадто то не здорово","Навіть із вправами: що занадто, то не здорово.","Дослівно \"перейти — це не дійти\". Перебрати міру в чомусь — така сама помилка, як зробити замало; з \"Бесід\" Конфуція, і досі звичайна мова."],["перевертати","Я перевертаю млинець.",null],["бути моторним","Його рухи моторні.",null],["заперечити","Він заперечив звинувачення.",null],["цілковитий розпач","Не впадайте в цілковитий розпач.",null],["попередити","Вони попередили про небезпеку.",null],["відкидати","Вони відкидали факт.",null],["зиск третього","Поки дві компанії билися, зиск дістався нам.",null],["узяти до уваги","Я взяв погоду до уваги.",null],["успадкувати","Я успадкував бабусину каблучку.",null],["чекати напоготові","Я чекав напоготові надворі.",null],["бути статечним","Його манера говорити статечна.",null],["смердіти","Смердить.",null],["казати через порівняння","Вони говорили про життя, порівнюючи його з подорожжю.",null],["поклястися","Я поклявся, що більше ніколи цього не зроблю.",null],["наблизитися","Я обережно наблизився.",null],["бути слабодухим","Я відкинув слабодухе серце.",null],["безупинно","Я безупинно вправлявся.",null],["пекти","Пече в шлунку.",null],["бути шаленим клопотом","Сьогодні шалений клопіт.",null],["підписати","Підпишіть тут, будь ласка.",null],["панувати","Вони панували над широкою землею.",null],["довести","Я довів факт.",null],["спиратися","Вони йдуть, спираючись на ціпок.",null],["уся історія від початку","Я пояснив усю історію від початку крок за кроком.",null],["бути всього лиш","Це всього лиш десять осіб.",null],["стати проти","Я став проти труднощів.",null],["суцільний туман","Справа й досі в суцільному тумані.",null],["затоптати","Не затоптуйте квітник.",null],["підтримувати","Я підтримую цю думку.",null],["передчасність","Вирішувати зараз передчасно.",null],["друг дитинства","Ми двоє — друзі дитинства.",null],["здобуток власними силами","Та людина власними силами збудувала велику компанію.",null],["нерішучість","Через нерішучість він завжди запізнюється.",null],["знемога від тривоги","Чекаючи на результат, я знемагав від тривоги.",null],["поставити себе на місце іншого","Якщо поставити себе на їхнє місце, стає зрозуміло.",null],["уявна зміна","Це уявна зміна.","Доглядач сказав мавпам, що зранку вони дістануть три каштани, а ввечері чотири; вони розлютилися. Він запропонував чотири зранку і три ввечері — і вони зраділи. Так називають уго
ια.",null],["συνεχίζω να ζω","Συνεχίζω να ζω με ζήλο.",null],["πέφτω πάνω σε κάποιον","Έπεσα πάνω σε έναν φίλο στον δρόμο.",null],["σχέση, σύνδεση","Έχει σχέση με αυτή την υπόθεση.",null],["άνετα, ξεκούραστα","Αναπαυθείτε με την ησυχία σας.",null],["σέβομαι, θαυμάζω","Σέβομαι πολύ τον δάσκαλό μου.",null],["υποστήριξη, στήριξη","Έλαβα υποστήριξη.",null],["παλιός, μακροχρόνιος","Συνάντησα έναν παλιό φίλο.",null],["συνέντευξη","Έχω μια συνέντευξη.",null],["ένα σωρό, μπόλικα","Έφαγα ένα σωρό φαγητό.",null],["ανησυχώ, νιώθω ανασφάλεια","Ανησυχώ μέχρι να βγει το αποτέλεσμα.",null],["ξεθάβω, βγάζω από τη γη","Βγάζω πατάτες από το χώμα.",null],["ανεβαίνω προς εδώ","Ανεβείτε στον επάνω όροφο, παρακαλώ.",null],["ρίχνω μια ματιά γύρω","Έριξα μια ματιά στο μαγαζί.",null],["φροντίζω","Φροντίζω τον ασθενή.",null],["χιλιάδες","Μαζεύτηκαν χιλιάδες άνθρωποι.",null],["είμαι αδιάθετος","Πού πονάτε;",null],["είμαι εκπληκτικός","Το αποτέλεσμα είναι εκπληκτικό.",null],["αναγνωρίζω","Αναγνώρισα αμέσως τον φίλο μου.",null],["πηγαίνω να δω κάποιον","Πήγα να δω τον δάσκαλό μου.",null],["φαντάζομαι","Προσπαθήστε να φανταστείτε τη θάλασσα.",null],["γεράματα","Αποταμιεύω για τα γεράματά μου.",null],["επιτέλους, μα τι","Μα τι συμβαίνει επιτέλους;",null],["τρέμω","Τα χέρια μου τρέμουν από το άγχος.",null],["γαμπρός, άντρας της κόρης","Ο γαμπρός μου οδήγησε.",null],["ευθεία, κατευθείαν","Στρίψτε δεξιά και συνεχίστε ευθεία.",null],["ακουμπώ κάτω, αφήνω κάτω","Αφήστε κάτω την τσάντα σας, παρακαλώ.",null],["σοκ, πλήγμα","Η είδηση μού προκάλεσε σοκ.",null],["συνειδητοποιώ","Συνειδητοποίησα το λάθος μου.",null],["συναντώ με σεβασμό","Πήγα να επισκεφτώ τον δάσκαλό μου.",null],["κάπως, για κάποιον λόγο","Για κάποιον λόγο νιώθω ωραία.",null],["στοιβάζω","Στοίβαξα τα βιβλία.",null],["θερμοκρασία σώματος","Μετρήστε πρώτα τη θερμοκρασία, παρακαλώ.",null],["κολλάω","Κολλάω ένα γραμματόσημο.",null],["βιαστικά","Βγήκα βιαστικά και ξέχασα την ομπρέλα μου.",null],["είμαι σαφής","Η σημασία είναι σαφής.",null],["χα
{"band":1,"locale":"ar","words":[null,["يفعل","أنا أدرس.","يعني «يفعل»، وهو محرّك بناء المفردات في الكورية. أضِفه إلى اسم فيصير فعلاً: 공부 (الدراسة) تصبح 공부하다 (يدرس)، و사랑 (الحب) تصبح 사랑하다. مئات الأفعال تُبنى بهذه الطريقة."],["سيارة","أركب السيارة.","سيارة. المقطع نفسه هو أيضاً كلمة الشاي، فـ차를 마셔요 تعني أشرب الشاي، و차를 타요 تعني أركب السيارة. الفعل هو ما يحدّد المقصود."],["امرأة","تلك المرأة طبيبة.",null],["مال","هناك مال في المحفظة.",null],["يكون في مكان","أنا في البيت.","كلمة واحدة حيث تستعمل العربية اثنتين: 있다 تعني «يوجد في مكان» و«يملك» معاً. 책상에 책이 있어요 الكتاب على المكتب؛ 시간이 있어요 عندي وقت. وضدّها 없다."],null,["أنا","أتعلّم الكورية.",null],["نحن","نحن أصدقاء.",null],["الشمس","الشمس ساطعة.",null],["بيت","أنا ذاهب إلى البيت.",null],["يد","أكتب بيدي.",null],["وقت","ليس لديّ وقت.","الوقت عموماً، وهي أيضاً أداة عدّ الساعات: 두 시간 تعني ساعتين. لا تخلطها بـ시 وهي الساعة على المِيناء — 두 시 تعني الساعة الثانية، وهذا شيء آخر تماماً."],["نعم","نعم، هذا صحيح.","ثلاث كلمات شائعة تُكتب 네. هذه هي «نعم». والأخريان «لك» (네 책، كتابك) والعدد الكوري «أربعة» قبل أداة العدّ (네 개، أربع قطع). السياق هو ما يفرّق بينها، لا الكتابة."],["كلب","الكلب يجري.",null],["طائر","طائر يطير.",null],["باب","أفتح الباب.",null],null,["جسم","أغسل جسمي كل يوم.",null],["غرفة","الغرفة نظيفة.",null],null,["عين","عيناك جميلتان.","العين. تُكتب تماماً مثل كلمة الثلج، وفي الكلام المتأنّي يفرّق بينهما الطول: 눈 الثلج تُمدّ، و눈 العين قصيرة. ومعظم المتحدثين يعتمدون على السياق."],["ملابس","الملابس جميلة.",null],["يذهب","أذهب إلى المدرسة.",null],["رأس","رأسي يؤلمني.",null],["مطر","إنها تمطر.",null],["فم","الفم صغير.",null],["ماء","أشرب الماء.",null],["ساق","ساقي تؤلمني.","ساق — ساقك، أو ساق طاولة أو كرسي. والكلمة نفسها تعني «جسر»، ولذلك 다리를 건너요 تعني «أعبر الجسر» لا شيئاً يخصّ الجسد."],["مدرسة","المدرسة كبيرة.",null],["وجه","أغسل وجهي.",null],null,["أنت (غير رسمي)","أين أنت؟",null],["لا يملك","ليس لديّ مال.",null],["أنا (بأدب)","أنا طالب.",null],["ذراع","ذراعاك طويلتان.",null],null,["أغنية","أغنّي أغنية.",null],["كتاب","أقرأ كتابًا.",null],["القمر","القمر منير.",null],["هاتف","أردّ على الهاتف.",null],["شجرة","الشجرة عالية.",null],["يرى","أشاهد فيلمًا.",null],["يوم كامل","اليوم طويل.",null],["إنسان","إنه شخص طيّب.",null],["هنا","تفضّل بالجلوس هنا.",null],["لماذا","لماذا تأخّرت؟",null],["العالم","العالم واسع.",null],null,["يتأخّر","تأخّرت الحافلة.",null],["قدم","قدماي باردتان.",null],["يوم","إنه يوم جميل.",null],["أنف","أنفي مسدود.",null],["صورة","ألتقط صورة.",null],["سرير","السرير مريح.",null],["جبل","أذهب إلى الجبل.",null],null,["الآن","سأذهب الآن.",null],["هدية","تعجبني الهدية.",null],["مستشفى","أذهب إلى المستشفى.",null],["الجميع","اجتمع الجميع.",null],["حقيبة","الحقيبة ثقيلة.",null],["موسيقى","الموسيقى جميلة.",null],null,["واحد","تفاحة واحدة من فضلك.",null],["بعد الظهر","لنلتقِ بعد الظهر.",null],["متجر","المتجر مغلق.",null],null,["طريق","الطريق واسع.",null],["أذن","أذني تؤلمني.",null],["قهوة","أشرب القهوة.",null],["وجبة","أتناول وجبة.",null],["حافلة","الحافلة قادمة.",null],["رسمة","أرسم رسمة.",null],["اليوم","الطقس جميل اليوم.",null],["حقًّا","شكرًا جزيلًا.","حقاً، فعلاً — أداة توكيد تسبق الصفة، كما في 정말 좋아요. وحدها، مع رفع الصوت في آخرها، تصير 정말? سؤالاً من كلمة واحدة: «حقاً؟». وهكذا ستسمعها أكثر ما تسمعها."],["كحول","لا أشرب الكحول.",null],["فيلم","الفيلم ممتع.",null],["مرة","افعل ذلك مرة أخرى من فضلك.",null],["يأتي","صديقي قادم.",null],["طائرة","أسافر بالطائرة.",null],["نجمة","النجوم تلمع.",null],["يشتري","أشتري خبزًا.",null],null,["أمي","أمي تطبخ.",null],null,["لحم","أشوي اللحم.",null],["الخارج","إنها تمطر في الخارج.",null],["تفاحة","التفاحة حلوة.",null],["بحر","البحر واسع.",null],["سماء","السماء زرقاء.",null],null,["قبعة","ألبس قبعة.",null],null,["شيء","أشتري أشياء.",null],["صديق","ألتقي بصديق.",null],["حذاء","ألبس حذائي.",null],null,["عيد ميلاد","عيد ميلاد سعيد.",null],["خمسة","جاء خمسة أشخاص.",null],["سوق","أشتري الخضار من السوق.",null],null,["طعام","الطعام الكوري لذيذ.",null],["فرصة","إنها فرصة جيدة.",null],["أبي","تصبح على خير يا أبي.",null],["قطة","القطة نائمة.",null],["حقيقي","هل هذا حقيقي؟",null],["صيف","أذهب إلى البحر في الصيف.",null],["لحظة","انتظر لحظة من فضلك.",null],["نافذة","أغلق النافذة من فضلك.",null],["رجل","ذلك الرجل صديقي.",null],["اثنان","هناك كرسيان.",null],null,["حيوان","أحب الحيوانات.",null],null,null,["سفر","أريد أن أسافر.",null],null,null,null,null,["ليل","هناك نجوم كثيرة في الليل.","ليل. تُكتب مثل كلمة «كستناء»، وهي وجبة خفيفة شائعة في خريف كوريا، ولذلك 밤을 먹어요 و밤에 자요 يتحدثان عن أمرين مختلفين تماماً."],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,["مرة أخرى","قل ذلك مرة أخرى من فضلك.",null],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null
{"band":2,"locale":"ar","words":[["معنى","ما معنى هذه الكلمة؟",null],["كلية","قُبلت في الجامعة.",null],["حديقة الحيوان","رأيت أسدًا في حديقة الحيوان.",null],["معطف","البس معطفك من فضلك.",null],["ما قبل الفجر","استيقظت قبل الفجر.",null],["لعبة","ألعب لعبة.",null],["لحم دجاج","لحم الدجاج قليل الدهن.",null],["يفقد","فقدت المفتاح.",null],["فول","وضعت الفول مع الأرز.",null],["جيتار","أعزف الجيتار.",null],["قبر","في الجبل قبر قديم.",null],["يسلق في الماء","أسلق بيضة.",null],["شكر","قدمت الشكر.",null],["متجر كبير متعدد الأقسام","اشتريت ملابس من المتجر الكبير.",null],["نحن، بتواضع","نحن سنساعدكم.",null],["أخت كبرى بالنسبة لفتاة","أختي الكبرى طالبة جامعية.","الكلمة التي تستعملها المرأة لأختها الكبرى؛ أما الرجل فيقول 누나 عن الشخص نفسه. وبها أيضاً تخاطب النساء امرأة أكبر قليلاً تربطهن بها ألفة، حتى في المتاجر."],["عرض فني","يبدأ العرض.",null],["صابون","أغسل يدي بالصابون.",null],["يسأل","سألت المعلم.",null],["هم","هم أصدقاء.",null],["رد فعل","كان رد فعل الناس جيداً جداً.",null],["حذاء جلدي","الحذاء مريح.",null],["مكتب بريد","أرسلت رسالة من مكتب البريد.",null],["إجازة","ذهبت في إجازة.",null],["ينادي","أنادي على تاكسي.",null],["يبكي","الرضيع يبكي.",null],["أريكة","اجلس على الأريكة واسترح.",null],["يدرس","أدرس اللغة الكورية كل يوم.",null],["يمشي","أمشي في الحديقة.","فعل شاذّ بالحرف ㄷ مثل 듣다: يصبح 걸어요 و걸었어요 قبل الحركة، و걷고 و걷습니다 قبل الحرف الساكن. كما أن 걸어요 هو تصريف 걸다 (يعلّق، يجري اتصالًا)، فـ전화를 걸어요 تعني يتّصل و공원을 걸어요 تعني يمشي في الحديقة، والمفعول به هو الذي يحدّد. لاحظ الاسم 걸음، أي خطوة."],["في ذلك الوقت","في ذلك الوقت كانت تمطر.",null],["مثل ذلك، من هذا النوع","لا يوجد شخص كهذا.",null],["رسالة","استلمت رسالة.",null],["مباراة","تبدأ المباراة قريبًا.",null],["اللون الأصفر","أخذت مظلة صفراء.",null],["دمية","الطفل يعانق دمية.",null],["ملعقة","آكل الشوربة بالملعقة.",null],["أخت كبرى (لأخيها)","أختي الكبرى تغنّي.","الكلمة التي يستعملها الرجل لأخته الكبرى. أما المرأة فتقول 언니 عن الشخص نفسه. الثنائي 누나/언니 يعمل تماماً كالثنائي 형/오빠: المتحدِّث هو الذي يحدِّد أيّ الكلمتين تُستعمل."],["صغ
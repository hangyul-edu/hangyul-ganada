att bli","Jag vill bli läkare.","Att bli. Det är också det vardagliga ordet för att något fungerar eller är tillåtet: 안 돼요 betyder det går inte, och 다 됐어요 betyder det är klart. Dem hör du långt oftare än ordboksbetydelsen."],["herr eller fru, efter ett namn","Minsu, ett ögonblick.","Efter ett förnamn är det artigt och vänligt mellan jämlikar: 민수 씨. Efter enbart efternamnet — 김 씨 — låter det distanserat eller rentav snäsigt, så använd förnamnet. Till en överordnad använder man titeln: 부장님, 선생님."],["att ringa","Jag ringer dig senare.",null],["morgon","Jag går upp på morgonen.",null],["höst","På hösten är vinden sval.",null],["blomma","Blomman är vacker.",null],["karta","Jag tittar på kartan.",null],["grönsaker","Ät mycket grönsaker, tack.",null],["skrivbord","Det ligger en bok på skrivbordet.",null],["att ge","Jag ger en present.",null],["första gången","Trevligt att träffas för första gången.",null],["frukt","Jag tycker om frukt.",null],["läkare","Läkaren undersöker mig.",null],["en ko","Kon äter gräs.",null],["hallå, i telefon","Hallå, vem är det?",null],["en dotter","Min dotter går i skolan.",null],["brev","Jag skriver ett brev till min mor.",null],["lite","Bara lite, tack.",null],["en sittplats","Det finns inga platser.",null],["att synas","Jag kan se berget.",null],["efter","Efter lektionen går jag till biblioteket.",null],["kort","Jag betalar med kort.",null],["i morgon","Vi ses i morgon.",null],["att vara viktig","Hälsan är det viktigaste.",null],["ett ägg","Jag äter ett ägg på morgonen.",null],["mycket","Det är mycket gott.",null],["en flod","Floden är mycket bred.",null],["att sätta sig","Jag satte mig på stolen.",null],["en sekund","Det är trettio sekunder kvar.",null],["att stämma","Det här svaret stämmer.",null],["ett företag, ett kontor","Jag går till kontoret.",null],["nyhet från någon","Jag har goda nyheter.",null],["kimchi","Kimchin är stark.",null],["att vara liten","Skorna är små.",null],["att läsa","Jag läser tidningen.",null],["och, och sedan","Jag
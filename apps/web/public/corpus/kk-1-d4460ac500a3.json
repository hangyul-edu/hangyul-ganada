,["корей тілі","Корей тілі қызық.",null],["тәулік бойы жұмыс істейтін дүкен","Үйімнің алдында тәулік бойы жұмыс істейтін дүкен бар.",null],["сондықтан","Жаңбыр жауып тұр, сондықтан бармаймын.",null],["көп","Көбірек жеңіз.",null],["екі, санау сөзінің алдында","Екі кофе беріңізші.","Корейдің төл сан есімдері сан есептейтін сөздің алдында тұлғасын өзгертеді. 하나 둘 셋 넷 деген 한 두 세 네 болады: жалғыз тұрғанда 하나, бір дана үшін 한 개. 두 — 둘 сөзінің сол тұлғасы, әрі ол ешқашан жалғыз тұрмайды."],["Америка Құрама Штаттары","Мен Америкаданмын.",null],["баға","Баға ойлағаннан қымбат.",null],["қоян","Қоян секіріп жүр.",null],["іні немесе қарындас","Інім сүйкімді.","Сөйлеушіге қарай өзгермейтін жалғыз бауыр сөзі: кім сөйлесе де, кішісі 동생. Жынысы керек болса бір буын қосыңыз — 남동생 інісі, 여동생 қарындасы."],["тұру","Кезекте тұрмын.",null],["мұз","Мұз қосыңызшы.",null],["табиғат","Табиғат әдемі.",null],["мөр басу","Мөр бастым.","Бірдеңені бетке басу: мөр, таңба, саусақ ізі. Дәл сол етістік суретке түсіруді — 사진을 찍다 — және тағамды тұздыққа малуды да қамтиды, үшеуі де бір басу идеясынан."],["көлік жүргізу","Көлік жүргізуді үйреніп жүрмін.",null],["картоп","Картопты қайнатамын.",null],["бұлт","Бұлт көп.",null],["шындық","Бұл шындық.",null],["саусақ","Саусағым ауырып тұр.",null],["себеп","Себебін айтыңызшы.",null],["ас үй","Ас үйде тамақ пісіремін.",null],["басқа","Басқа түстер бар ма?",null],["жасыл пияз","Сорпаға сәл жасыл пияз қостым.",null],["ұстау","Қолыңды ұстаймын.",null],["пайдалану","Қалай пайдаланатынын айтыңызшы.",null],["гүлдеу","Гүлдер ашылды.",null],["ақпарат","Ақпарат іздеп жүрмін.",null],["қажеттілік","Маған көмек қажет емес.",null],["әуежай","Әуежайға жеттім.",null],["алу","Сыйлық алдым.",null],["ата-ана","Балаға ата-ана керек.",null],["сүю","Отбасымды сүйемін.",null],["жүзу","Жүзуді үйреніп жүрмін.",null],["былай","Былай жазыңызшы.",null],["жұмыс істеу","Анам ауруханада жұмыс істейді.",null],["солтүстік","Олар солтүстікке кетті.",null],["қажет болу","Маған ақша керек.",nul
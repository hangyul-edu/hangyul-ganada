canso.",null],["censurar","No censure a la ligera.",null],["apisonar, afirmar","Apisonaron bien el suelo.",null],["grabar","Grabé un nombre en la madera.",null],["salir todo sin un tropiezo","La reunión salió sin un tropiezo.",null],["quien siembra vientos recoge tempestades","No estudió, así que se lo ha buscado.","Literalmente \"obra propia, provecho propio\". La consecuencia que uno se buscó: reproche si es a otro, admisión si es a uno mismo."],["revertir","Revertí la pantalla.",null],["matar dos pájaros de un tiro","Con este método matas dos pájaros de un tiro.","Modismo de cuatro caracteres: literalmente \"una piedra, dos pájaros\". Se usa cuando una sola acción trae dos beneficios."],["cada oveja con su pareja","Cada oveja con su pareja, y es bien cierto.",null],["ser igual que","Es igual que ayer.",null],["desempeñar","Desempeñaron la misión.",null],["retirarse","Retrocedí un paso.",null],["ser elegante","Sus movimientos son elegantes.",null],["perseguir","Persigo la felicidad.",null],["tender, sacar","Tendí la mano.",null],["alcanzar","Alcanzamos la cima.",null],["ser ventajoso","Nos resulta ventajoso.",null],["vengarse","Decidí no vengarme.",null],["comportarse alborotado","No te alborotes delante de los mayores.",null],["colgar de","El niño cuelga de la barra.",null],["ordenar","El capitán dio la orden.",null],["ser dado","Se me dio una oportunidad.",null],["retirarse","El ejército se retiró.",null],["ser miserable","Me sentí miserable.",null],["los grandes talentos maduran tarde","Hay un dicho: los grandes talentos maduran tarde.",null]]}

ός είναι σταρ.",null],["στρατιώτης","Ένας στρατιώτης στέκεται εκεί.",null],["με ζήλο, επιμελώς","Μελετώ με ζήλο.",null],["υγεία","Περπατώ κάθε μέρα για την υγεία μου.",null],["ανάσα","Ανέβηκα τις σκάλες και μου κόπηκε η ανάσα.",null],["άτομο","Υπάρχουν πέντε μαθητές.",null],["αλείφω","Αλείφω μαρμελάδα στο ψωμί.",null],["κάνει ζέστη","Το καλοκαίρι κάνει ζέστη.",null],["πριν από λίγο","Τηλεφώνησα πριν από λίγο.",null],["πουλιέμαι","Τα εισιτήρια πουλήθηκαν όλα.",null],["κείμενο","Έγραψα ένα σύντομο κείμενο.",null],["δένω","Δένω τα κορδόνια μου.",null],["είμαι χαμηλός","Η καρέκλα είναι χαμηλή.",null],["αποτέλεσμα","Το αποτέλεσμα είναι καλό.",null],["απόδειξη","Την απόδειξη, παρακαλώ.",null],["μοτοσικλέτα","Η μοτοσικλέτα κάνει θόρυβο.",null],["μαϊμού","Η μαϊμού σκαρφαλώνει στο δέντρο.",null],["προστατεύω","Προστατεύουν τη χώρα.",null],["ημερομηνία","Ορίσαμε την ημερομηνία της συνάντησης.",null],["είμαι ευγενικός","Ο γείτονάς μου είναι πολύ ευγενικός.",null],["ακολουθώ","Πρέπει να ακολουθείτε τους κανόνες του σχολείου.",null],["βγάζω (ρούχα, παπούτσια)","Βγάλτε τα παπούτσια σας, παρακαλώ.",null],["έλεγχος, επιβεβαίωση","Ελέγξτε το, παρακαλώ.",null],["θυμάμαι","Ακόμα θυμάμαι το όνομα εκείνου του ανθρώπου.",null],["ίχνος","Πάνω στο χιόνι έμειναν ίχνη.",null],["κόβω, μαζεύω (καρπό)","Μάζεψα ένα μήλο.",null],["κάποια μέρα","Κάποια μέρα θα πάω στην Κορέα.",null],["περιεχόμενο","Ξαναδιάβασα το περιεχόμενο του γράμματος.",null],["κυρία (στην ηλικία των γονιών)","Ρώτησα την κυρία για τον δρόμο.","Γυναίκα περίπου στην ηλικία των γονιών σας, και η ευγενικότερη από τις δύο λέξεις — το 아줌마 είναι το απότομο. Ακόμη κι έτσι, για να σταματήσετε μια άγνωστη ο ασφαλής δρόμος παραμένει το 저기요."],["κόστος","Η επισκευή κόστισε πολλά.",null],["νόμος","Όλοι πρέπει να τηρούν τον νόμο.",null],["κράτηση","Άλλαξα την κράτηση για τις δύο.",null],["αμέσως, σε μια στιγμή","Θα γυρίσω αμέσως.",null],["φυτεύω","Φυτεύω ένα δέντρο.",null],["εις υγείαν","Λοιπόν, εις υγείαν!",null],["όλη μέρα","Έβρεχε όλη μέ
ά.",null],["είμαι γρήγορος","Το τρένο είναι γρήγορο.",null],["μεσήλικας άντρας","Κύριε, εδώ!","Άντρας περίπου στην ηλικία των γονιών σας. Στέκει όταν μιλάτε για έναν άγνωστο άντρα· ως προσφώνηση είναι ριψοκίνδυνη, γιατί όποιος δεν θεωρεί τον εαυτό του μεσήλικα μπορεί να παρεξηγηθεί. Για να απευθυνθείτε σε οποιονδήποτε υπάρχει το 저기요."],["είμαι νόστιμος","Το κίμτσι είναι νόστιμο.",null],["Παρασκευή","Έχω εξετάσεις την Παρασκευή.",null],["ημέρα της εβδομάδας","Τι μέρα είναι σήμερα;",null],["βάζω σε δοχείο","Βάζω το ρύζι στο μπολ.",null],["έντομο","Ένα έντομο περνάει.",null],["αμέσως","Θα έρθω αμέσως.",null],["ιδιοκτήτης","Ο ιδιοκτήτης του μαγαζιού είναι ευγενικός.",null],["τραυματισμός","Ο παίκτης υπέστη σοβαρό τραυματισμό.",null],["θείος","Ήρθε ο θείος μου.",null],["ο εαυτός μου","Πιστέψτε στον εαυτό σας.",null],["χειροκρότημα","Ένα χειροκρότημα, παρακαλώ.",null],["καυτερή πιπεριά","Η πιπεριά είναι πολύ καυτερή.",null],["παράδειγμα","Δώστε ένα παράδειγμα, παρακαλώ.",null],["είμαι νέος","Είστε ακόμα σε νεαρή ηλικία.",null],["κήπος","Φύτεψα λουλούδια στον κήπο.",null],["είμαι ευτυχισμένος","Νιώθω ευτυχία αυτή τη στιγμή.",null],["κέικ ρυζιού","Στις γιορτές τρώμε κέικ ρυζιού.",null],["μετρητά","Πλήρωσα με μετρητά.",null],["χώρος","Υπάρχει άφθονος χώρος κάτω από το γραφείο.",null],["δαγκώνω","Ο σκύλος δεν δαγκώνει.",null],["συνέχεια","Συνεχίζει να βρέχει.",null],["φέρνω","Έφερα την εργασία μου.",null],["πιθανότητα","Η πιθανότητα να βρέξει αύριο είναι υψηλή.",null],["κουβέρτα","Σκεπάστε με με μια κουβέρτα, παρακαλώ.",null],["έχω, κατέχω","Έχω ένα μολύβι.",null],["σβήνω","Σβήστε το φως, παρακαλώ.",null],["φαρμακείο","Αγόρασα φάρμακα από το φαρμακείο.",null],["σταματώ","Το αυτοκίνητο σταμάτησε.",null],["λεξικό","Ψάχνω μια λέξη στο λεξικό.",null],["αίμα","Βγαίνει αίμα από το δάχτυλό μου.",null],["είμαι δύσκολος, κουραστικός","Η δουλειά σήμερα ήταν κουραστική.",null],["ζητώ συγγνώμη","Ζητώ συγγνώμη που άργησα.",null],["λάθος","Έκανα ένα λάθος.",null],["χαίρομαι για τη γνωριμία
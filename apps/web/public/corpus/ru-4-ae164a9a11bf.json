авшись.",null],["болеть за, поддерживать","Я болею за нашу команду.",null],["быть взвинченным, нервничать","В ожидании результата нервы были на пределе.",null],["код","Введите, пожалуйста, код.",null],["битва","Битва окончена.",null],["немедленно","Ответьте, пожалуйста, немедленно.",null],["оказываться запертым","Меня закрыло в лифте.",null],["платить","Оплата прошла картой.",null],["никогда, ни в коем случае","Я никогда не забуду.",null],["рождение","Мы отпраздновали рождение малыша.",null],["завершение, финальный штрих","Завершение получилось удачным.",null],["ага","Ага, теперь понятно.",null],["испытывать гордость","Глядя на результат, я испытываю гордость.",null],["гнаться следом","Щенок всё бежал за мной следом.",null],["настолько, столько же","Это настолько трудно.",null],["человечество","Мы изучаем историю человечества.",null],["вести себя","Младший брат ведёт себя хорошо.",null],["шуметь, галдеть","Не шумите, пожалуйста, в классе.",null],["обманывать","Не обманывайте людей.",null],["как душе угодно","Выбирайте, пожалуйста, что душе угодно.",null],["задание, миссия","Задание выполнено.",null],["управлять, вести дело","Я держу небольшой магазин.",null],["быть твёрдым, крепким","Лёд твёрдый.",null],["расширение, увеличение","Круг получателей поддержки расширили.",null],["невестка","Невестка пришла с визитом.",null],["оглядываться назад","Мы оглянулись на прошлое.",null],["несколько, некоторые","Пришло лишь несколько человек.",null],["огромный успех, джекпот","Этот фильм — огромный хит.",null],["сплошь, целиком","Всё сплошь покрыто снегом.",null],["сожаление","Выражаем глубокое сожаление в связи с этим происшествием.","Слово, к которому прибегают власти или компании. 유감을 표하다 — примерно «выразить сожаление»: признать, что что-то пошло не так, по сути не принося извинений. Корейцы эту дистанцию слышат."],["жених","Жених улыбается.",null],["скручивать, сплетать","Я скручиваю нитки.",null],["чутьё, сообразительность","Они мгновенно улавливают обстановку.",null],["чтить, увековечивать","Мы чтим эти заслуги.",null],["быть колоссальным","Это колоссальная популярность.",null],["портиться","Молоко испортилось.",null],["график, диаграмма","Мы посмотрели график.",null],["горевать","Не горюйте, пожалуйста, так сильно.",null],["пугаться","Этот звук меня напугал.",null],["молодой человек, молодёжь","Здесь много молодёжи.",null],["скапливаться, наворачиваться","У меня на глаза навернулись слёзы.",null],["портить, проваливать","Экзамен провален.",null],["быть безупречным","Подготовка безупречна.",null],["подходить, приближаться","Мы тихо подошли.",null],["щедро, вдоволь","Рис щедро полит соусом.",null],["пробиваться сквозь","Сюда пришлось пробираться через заснеженную дорогу.",null],["пуля","Пуля летит быстро.",null],["держаться, выдерживать","Мне удалось продержаться до конца.",null],["сплетать, составлять","Из этих историй они составили книгу.",null],["болеть чем-либо","У меня была простуда.",null],["впервые слышу","Об этом я слышу впервые.",null],["бок о бок, рядом","Двое шли бок о бок.",null],["не хватать","Мне не хватает денег.",null],["приходить в голову","Мне в голову пришла хорошая идея.",null],["месть","Месть — это нехорошо.","Месть. Тем же словом в грамматике называют множественное число — 복수형, форма множественного числа, — а в больнице оно может означать жидкость в брюшной полости. Какое значение, показывает предложение."],["представлять","Они представляют школу.",null],["обнаруживать, показывать","Мои истинные чувства раскрылись.",null],["рвать, тошнить","Ребёнка вырвало.",null],["быть уютным","Эта комната маленькая, но уютная.",null],["признание","Мои способности получили признание.",null],["быть осторожным, остерегаться","Будьте, пожалуйста, осторожны на лестнице.",null],["ход, течение процесса","Строительные работы ещё идут.",null],["обычный, рядовой","Обычным посетителям сюда.",null],["притворяться","Пришлось притвориться, что ничего не знаю.",null],["ползать","Малыш ползает по комнате.",null],["десятки","Пришли десятки людей.",null],["агент, сотрудник","Агент прибыл.",null],["прямо, ровно","Встаньте, пожалуйста, ровно.",null],["быть чёрным-пречёрным","Небо совсем чёрное.",null],["объявлять, докладывать","Результаты объявили.",null],["чисто, дочиста","Вымойте, пожалуйста, руки дочиста.",null],["безопасность, охрана","Охрана здесь строжайшая.",null],["склонять, наклонять","Я здороваюсь, склонив голову.",null],["быть поразительным, диковинным","Это просто поразительно.",null],["шататься, качаться","Автобус сильно качает.",null],["быть дотошным","Они дотошны по натуре.",null],["быть жёстким, чёрствым","Хлеб чёрствый.",null],["молиться, желать","Я молюсь о вашем здоровье.",null],["тут и там, повсюду","Пришлось искать повсюду.",null],["одевать кого-либо","Ребёнок одет.",null],["справляться, обращаться к источнику","Обратитесь, пожалуйста, к инструкции.",null],["первая любовь","Я до сих пор помню свою первую любовь.",null],["навсегда, вечно","Я запомню это навсегда.",null],["увеличиваться, растягиваться","Посетителей стало больше.",null],["сталкиваться","Мы столкнулись плечами.",null],["хотя, пусть даже","Пусть и с опозданием, но я здесь.",null],["уходить, отплывать","Корабль уплыл.",null],["вовсе, совсем","Мы туда вовсе не пошли.",null],["возможно, может быть","Возможно, пойдёт дождь.",null],["ложиться ничком","Пришлось лечь ничком на пол.",null],["быть простым","Форма простая.",null],["убийство","Произошло убийство.",null],["заваривать, вываривать","Я завариваю лечебные травы.",null],["бросать, прекращать","Пожалуй, я просто это брошу.",null],["переодеваться","Я уже в другой одежде.",null],["вволю, сколько душе угодно","Ешьте, пожалуйста, сколько душе угодно.",null],["быть прохладным, зябким","Утренний воздух прохладный.",null],["беда не приходит одна","Мало того что поздно, так вдобавок ещё и дождь пошёл.","Буквально «иней поверх снега». Одна беда приходит, пока не кончилась другая, — по-русски «беда не приходит одна»."],["структура, устройство","Устройство здания простое.",null],["ответ невпопад","На мой вопрос они отвечали только невпопад.","Буквально «спросили о востоке — ответил о западе». Ответ, не имеющий отношения к вопросу; говорится обычно с лёгкой досадой."],["быть густым, тёмным","Цвет тёмный.",null],["протекать","Крыша протекает.",null],["равномерно, всего понемногу","Ешьте всего понемногу, включая овощи.",null],["существовать","Такое место существует?",null],["понижать","Убавьте, пожалуйста, звук.",null],["греться на солнце","Я греюсь на солнышке.",null],["что угодно","Спрашивайте меня о чём угодно.",null],["наоборот, вверх ногами","Буквы написаны вверх ногами.",null],["подгузник","Я меняю подгузник.",null],["ой, батюшки","Батюшки, это правда?",null],["сдаваться, капитулировать","В конце концов они сдались.",null],["кислород","Кислорода не хватает.",null],["сжигать","Письмо сожжено.",null],["расследовать, обследовать","Они расследуют это дело.",null],["только, единственно","Есть лишь один-единственный.",null],["выходить вперёд, браться","Первый шаг вперёд был сделан мной.",null],["надвигаться вплотную","Экзамен уже на носу.",null],["быть глупым","Это было глупое решение.",null],["одно к одному, вдвойне хорошо","И дёшево, и вкусно — лучше не придумаешь.","Буквально «добавить цветы к парче». К тому, что и так хорошо, добавляется ещё одно достоинство — «вишенка на торте»."],["махать, трясти","Я машу рукой.",null],["быть сладким","Аромат сладкий.",null],["суд, судебный процесс","Состоялся суд.",null],["становиться страшно","Мне стало страшно от лая собаки.",null],["работать, функционировать","Механизм работает исправно.",null],["принадлежать, относиться","Я состою в этой команде.",null],["перемещаться","Перемещаемся в другую комнату.",null],["скрывать, прятать","Свои чувства пришлось скрыть.",null],["безоговорочно, во что бы то ни стало","Мне нужно пойти во что бы то ни стало.",null],["признавать","Мне пришлось признать свою ошибку.",null],["миллионы","Это смотрят миллионы людей.",null],["не особенно, ничего конкретного","Мне особо нечего
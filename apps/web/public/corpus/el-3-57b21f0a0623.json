ίτε με την κουβέρτα.",null],["πάρα πολύ, φοβερά","Είναι πάρα πολύ νόστιμο.",null],["εντελώς","Ανάρρωσα εντελώς.",null],["ακουμπώ, στηρίζομαι","Ακούμπησα στον τοίχο.",null],["μιλώ, με ευγένεια","Μιλήστε αργά, παρακαλώ.",null],["αναφορά, έκθεση","Παρέδωσα την αναφορά.",null],["εργασίες κατασκευής","Ο δρόμος είναι κλειστός λόγω εργασιών.",null],["πέφτω μέσα, βυθίζομαι","Έπεσα στο νερό.",null],["η γλώσσα μας","Ας χρησιμοποιούμε όμορφα τη γλώσσα μας.",null],["εκνευρισμός","Εκνευρίζομαι.",null],["πρώτος","Καθίστε στην πρώτη σειρά, παρακαλώ.",null],["αριθμός","Μετρήστε τους αριθμούς.",null],["νεότερος συνάδελφος","Κέρασα μεσημεριανό τον νεότερο συνάδελφό μου.",null],["πηγαίνω με τα πόδια","Πηγαίνω στο σχολείο με τα πόδια.",null],["κάτι","Κάτι είναι παράξενο.",null],["αποφοιτώ","Αποφοιτώ του χρόνου.",null],["ελέφαντας","Ο ελέφαντας πίνει νερό.",null],["ροζ","Το ροζ χρώμα είναι όμορφο.",null],["μάγουλο","Τα μάγουλά μου κοκκίνισαν από το κρύο.",null],["κυλάω κάτι","Κυλάω την μπάλα.",null],["εκείνη η μέρα","Εκείνη τη μέρα έβρεχε.",null],["στεγνώνω","Η μπουγάδα στέγνωσε καλά.",null],["τακτοποίηση","Τακτοποίησα το δωμάτιο.",null],["στο μεταξύ, όλο αυτό το διάστημα","Ήσασταν καλά όλο αυτό το διάστημα;",null],["τέλος του χρόνου","Στο τέλος του χρόνου γίνονται πολλές συναντήσεις.",null],["κάνω ντους","Κάνω ντους το πρωί.",null],["πληρώνω τον λογαριασμό","Θα πληρώσω εγώ.",null],["τσίχλα","Μη μασάτε τσίχλα στο μάθημα.",null],["καθημερινότητα","Επέστρεψα στην καθημερινότητα.",null],["κάπου","Κάπου θα είναι.",null],["ταξιδεύω","Το καλοκαίρι ταξιδεύω στο νησί Τζετζού.",null],["βαθιά","Το σαββατοκύριακο ξεκουραστείτε καλά.",null],["προσεύχομαι","Προσευχήθηκα σιωπηλά.",null],["εμπόδιο, φράγμα","Το γλωσσικό εμπόδιο είναι μεγάλο.",null],["πλαστικό","Το πλαστικό πετιέται ξεχωριστά.",null],["τουρίστας","Οι τουρίστες βγάζουν φωτογραφίες.",null],["υπάλληλος εταιρείας","Ήρθε ένας νέος υπάλληλος.",null],["γενέθλια, με σεβασμό για μεγαλύτερο","Είναι τα γενέθλια της γιαγιάς μου.",null],["πάνω μέρος
ασία","Εμένα δεν με πειράζει.",null],["πετυχαίνω","Το πείραμα αυτή τη φορά πέτυχε.",null],["ταυτότητα","Δείξτε μου την ταυτότητά σας, παρακαλώ.",null],["υπόγειο","Υπάρχει ένα μαγαζί στο υπόγειο.",null],["οδηγώ","Η μητέρα μου οδηγεί το αυτοκίνητο.",null],["στάση","Η στάση είναι πολύ καλή.",null],["τοπίο","Το τοπίο από το παράθυρο είναι όμορφο.",null],["μαγειρεύω στον ατμό","Μαγειρεύω τα ραβιόλια στον ατμό.",null],["δημοσιογράφος","Ο δημοσιογράφος κάνει μια ερώτηση.",null],["μυθιστοριογράφος","Γνώρισα έναν διάσημο μυθιστοριογράφο.",null],["μηχανισμός, συσκευή","Υπάρχει μηχανισμός ασφαλείας.",null],["γαμήλια τελετή","Πήγα σε έναν γάμο.",null],["χαιρετίσματα","Δώστε τα χαιρετίσματά μου στους γονείς σας.",null],["διάφοροι, αρκετοί","Έχω επισκεφτεί αρκετές χώρες.",null],["πύργος","Στον ναό υπάρχει ένας παλιός πύργος.",null],["μαγειρευτό","Το μαγειρευτό είναι ζεστό.",null],["θλίψη","Η θλίψη έσβησε λίγο λίγο.",null],["αμφιβολία","Εκείνα τα λόγια μού γέννησαν αμφιβολίες.",null],["ντους","Έκανα ντους.",null],["εξηγώ","Εξηγήστε το ξανά, παρακαλώ.",null],["χρήστης","Ο αριθμός των χρηστών αυξήθηκε πολύ.",null],["μαθηματικά","Τα μαθηματικά είναι δύσκολα.",null],["πώς είμαι, σε τι κατάσταση βρίσκομαι","Πώς είναι ο καιρός;",null],["μετάνιωμα","Δεν μετανιώνω για τίποτα.",null],["γεμίζω, είμαι γεμάτος","Το δωμάτιο ήταν γεμάτο κόσμο.",null],["βάση","Φτάσαμε στη βάση.",null],["θέλημα","Πήγα στο μαγαζί για ένα θέλημα της μαμάς.",null],["ανιψιός, ανιψιά","Ο ανιψιός μου είναι πέντε χρονών.",null],["ξεκινώ, αναχωρώ","Ξεκινάμε νωρίς το πρωί.",null],["υπάλληλος","Το προσωπικό είναι ευγενικό.",null],["εισαγωγή στο νοσοκομείο","Ένας φίλος μου μπήκε στο νοσοκομείο.",null],["αντίθεση, διαφωνία","Εγώ διαφωνώ.",null],["προσοχή","Στις σκάλες χρειάζεται προσοχή.",null],["πρόεδρος χώρας","Ο πρόεδρος μίλησε.",null],["ανακάλυψη","Ήταν μια μεγάλη ανακάλυψη.",null],["εξάμηνο","Άρχισε το νέο εξάμηνο.",null],["μόνος μου, από μόνος μου","Δοκιμάστε το μόνοι σας.",null],["είμαι έντονος, σοβαρός","Ο βήχας είνα
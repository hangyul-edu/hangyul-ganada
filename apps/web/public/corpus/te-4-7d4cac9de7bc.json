ull],["ఎత్తుకో","నేలపై నుంచి పెన్సిల్ ఎత్తుకున్నాను.",null],["సంతకం","ఇక్కడ సంతకం చేయండి.",null],["వాసన వచ్చు","వంటగది నుంచి వాసన వస్తోంది.",null],["సమ్మతి","సమ్మతి కోరాను.",null],["పరుగెత్తుకుంటూ రావడం","కుక్కపిల్ల నా దగ్గరకు పరుగెత్తుకుంటూ వచ్చింది.",null],["ఒక మాట","ఒక మాట మాత్రం చెబుతాను.",null],["నొక్కు","బటన్ నొక్కుతాను.",null],["ఉద్యోగ మార్పు","ఈ మధ్య ఉద్యోగం మార్చాలని ఆలోచిస్తున్నాను.",null],["సంస్థ","సంస్థ పెద్దది కాదు.",null],["మూల","మూల తిరిగితే ఉంటుంది.",null],["కవలలు","కవలలు పుట్టారు.",null],["పెంచు","జుట్టు పెంచాను.",null],["నిర్ణయమవు","తేదీ వచ్చే వారంగా నిర్ణయమైంది.",null],["పారిపో","దొంగ పారిపోయాడు.",null],["గ్రహాంతరవాసి","అంతరిక్ష నౌక నుంచి ఒక గ్రహాంతరవాసి దిగాడు.",null],["లోతైన పరిశీలన","ఈ సమస్యకు మరింత లోతైన పరిశీలన అవసరం.",null],["మెరుగుపడు","నా కొరియన్ మెరుగుపడింది.",null],["గట్టిగా ఉండు","మంచు గట్టిగా ఉంది.",null],["పరుగెత్తి వెళ్ళు","స్టేషన్ వరకు పరుగెత్తాను.",null],["వెలుగుగా ఉండు","గది వెలుగుగా ఉంది.",null],["ఆలస్యమవు","ఆలస్యంగా పశ్చాత్తాపపడ్డాను.",null],["లెక్కలేనన్ని ఉండు","లెక్కలేనంత మంది గుమిగూడారు.",null],["సణుగుడు","సణుగుడు విన్నాను.",null],["ఆట ఆడు","తమ్ముడితో ఆట ఆడాను.",null],["నిర్ణయించుకో","వ్యాయామం మొదలుపెట్టాలని నిర్ణయించుకున్నాను.",null],["మౌలికంగా","మౌలిక ప్రణాళిక వేరుగా ఉండేది.",null],["విచారణ","వివరమైన విచారణలు ఫోన్ ద్వారా చేయండి.",null],["ఆదేశించు","బృంద నాయకుడు క్రమాన్ని ఆదేశించారు.",null],["మార్చుకో","బట్టలను మార్పిడి చేసుకున్నాను.",null],["నేటి కాలం","నేటి కాలంలో అందరూ మొబైల్ వాడుతున్నారు.",null],["కోడ్","కోడ్ నమోదు చేయండి.",null],["తక్షణం","తక్షణం జవాబు ఇవ్వండి.",null],["మరచిపో","అపాయింట్మెంట్ మరచిపోయాను.",null],["సూత్రం","సూత్రం ప్రకారం పరిష్కరించాను.",null],["మోసగించు","మనుషులను మోసగించవద్దు.",null],["ఎప్పటికీ కాదు","ఎప్పటికీ మరచిపోను.",null],["ముగింపు","ముగింపు బాగుంది.",null],["సరిపడా ఉండటం","ఈ గది పరిమాణం సరిపడా ఉంది.",null],["పదును పెట్టు","కత్తికి పదును పెడతాను.",null],["చేరు","సాయంత్రం సమావేశంలో చేరతాను.",null],["మానవాళి","మానవాళి చరిత్రను నేర్చుకుంటాం.",null],["ఇష్టం వచ్చినట్టు","ఇష్టం వచ్చినట్టు ఎంచుకోండి.",null],["కరకరలాడు","వేయించినది చాలా కరకరలాడుతోంది.",null],["ఒలకబోయు","నీళ్లు ఒలకబోశాను.",null],["బాధ్యత","బాధ్యతను పూర్తి చేశాను.",null],["ఆహా","ఆహా, ఇప్పుడు అర్థమైంది.",null],["అంతగా","అంతగా కష్టం.",null],["ఆత్రుతగా ఉండు","ఫలితం కోసం ఎదురుచూస్తూ ఆత్రుతగా ఉన్నాను.",null],["కోరుకో","ఆరోగ్యం కోరుకుంటున్నాను.",null],["కొందరు","కొందరు మాత్రమే వచ్చారు.",null],["చెడిపో","పాలు చెడిపోయాయి.",null],["ఊపు","చేయి ఊపుతాను.",null],["నలభై","నలభై దాటాను.",null],["తీయగా ఉండు","వాసన తీయగా ఉంది.",null],["బాధపడు","వీడ్కోలు చెప్పకుండా వెళ్ళిపోయినందుకు బాధపడ్డాను.",null],["విచారం","ఈ విషయంలో మేము తీవ్ర విచారం వ్యక్తం చేస్తున్నాం.","ప్రభుత్వం లేదా సంస్థ ఆశ్రయించే పదం. 유감을 표하다 అంటే దాదాపు *విచారం వ్యక్తం చేయడం*: ఏదో తప్పు జరిగిందని ఒప్పుకుంటుంది కానీ నిజమైన క్షమాపణ కాదు; కొరియన్ పాఠకుడు ఆ దూరాన్ని గ్రహిస్తాడు."],["కీర్తించు","విజయాన్ని కీర్తిస్తాం.",null],["పాడుచేయు","పరీక్ష పాడుచేసుకున్నాను.",null],["నిర్వహించు","చిన్న దుకాణం నిర్వహిస్తాను.",null],["పరిస్థితిని గ్రహించే నేర్పు","పరిస్థితిని త్వరగా గ్రహిస్తారు.",null],["ప్రోత్సహించు","మా జట్టును ప్రోత్సహిస్తాను.",null],["పూర్తిగా","పూర్తిగా మంచుతో కప్పబడింది.",null],["వెనక్కి చూడు","గతాన్ని వెనక్కి చూశాను.",null],["పెళ్ళికొడుకు","పెళ్ళికొడుకు నవ్వుతున్నాడు.",null],["ఘన విజయం","ఈ సినిమా ఘన విజయం.",null],["సహోద్యోగుల విందు","కంపెనీ విందులో ఆలస్యం వరకు ఉన్నాను.","ఇది మామూలు భోజనం కాదు: పని బృందంతో కలిసి, తరచుగా పైఅధికారి ఏర్పాటు చేసే రాత్రి విందు; కొరియా కార్యాలయ సంస్కృతిలో స్థిరమైన భాగం. హాజరు సగం తప్పనిసరిగా అనిపిస్తుంది, సాయంత్రం రెండో మూడో చోటికి (2차, 3차) కొనసాగవచ్చు. కొరియాలో ప్రతి కార్యాలయ ఉద్యోగీ వాడే పదం."],["పని పురోగతి","నిర్మాణ పని పురోగతి వేగంగా ఉంది.",null],["చార్ట్","చార్ట్ చూశాను.",null],["జననం","పాప జననాన్ని జరుపుకున్నాం.",null],["సారాంశ భాగం","నివేదికలోని సారాంశ భాగాన్ని చదివాం.",null],["అద్భుతంగా ఉండు","నిజంగా అద్భుతంగా ఉంది.",null],["యువకుడు","యువకులు చాలామంది ఉన్నారు.",null],["వెంబడిస్తూ రా","కుక్కపిల్ల నిరంతరం వెంబడిస్తూ వచ్చింది.",null],["భయపడిపో","శబ్దానికి భయపడ్డాను.",null],["గుండ్రంగా ఉండటం","చంద్రుడు గుండ్రంగా ఉన్నాడు.",null],["సరిపోకపో","డబ్బు సరిపోవడం లేదు.",null],["ఒలింపిక్స్","నేను టీవీలో ఒలింపిక్స్ చూశాను.",null],["నిశితంగా గమనించు","పరిస్థితిని నిశితంగా గమనిస్తున్నాం.",null],["స్ఫురించు","మంచి ఆలోచన స్ఫురించింది.",null],["కోడలు","కోడలు నమస్కారం చేయడానికి వచ్చింది.",null],["ప్రయోజనం లేకపో","ఇప్పుడు పశ్చాత్తాపపడి ప్రయోజనం లేదు.",null],["చిన్నదిగా ఉండటం","నాకు ఒక చిన్న పెట్టె వచ్చింది.",null],["అణచివేత","సుదీర్ఘ అణచివేత నుంచి బయటపడ్డారు.",null],["ప్రతీకారం","ప్రతీకారం మంచిది కాదు.","ప్రతీకారం. అదే విధంగా రాసే పదం వ్యాకరణంలో బహువచనాన్ని కూడా సూచిస్తుంది — 복수형, బహువచన రూపం — ఆసుపత్రిలో అయితే ఉదరంలో నీరు చేరడాన్ని అర్థం ఇవ్వవచ్చు. ఏది అనేది వాక్యం చెబుతుంది."],["నిలదొక్కుకో","చివరి వరకు నిలదొక్కుకున్నాను.",null],["గర్వంగా ఉండు","ఫలితం చూసి మనసు గర్వంగా ఉంది.",null],["సద్వినియోగం చేయడం","నేను వారాంతపు సమయాన్ని బాగా సద్వినియోగం చేస్తాను.",null],["విస్తరణ","సాయం పొందేవారి పరిధిని విస్తరించారు.",null],["బట్టలు మార్చుకో","బట్టలు మార్చుకున్నాను.",null],["కొనసాగడం","పని కొనసాగుతోంది.",null],["అనారోగ్యంతో ఉండు","జలుబుతో అనారోగ్యంతో ఉన్నాను.",null],["వాంతి చేసుకో","పిల్లవాడు వాంతి చేసుకున్నాడు.",null],["నిలిచిపో","కళ్ళలో కన్నీళ్లు నిలిచాయి.",null],["సిబ్బంది","సిబ్బంది చేరుకున్నారు.",null],["గుర్తింపు","నా నైపుణ్యానికి గుర్తింపు లభించింది.",null],["ప్రతి సంవత్సరం","ప్రతి సంవత్సరం వసంతంలో పువ్వులు పూస్తాయి.",null],["నటించు","తెలియనట్టు నటించాను.",null],["నిటారుగా","నిటారుగా నిలబడండి.",null],["హాయిగా ఉండు","ఈ గది చిన్నది కానీ హాయిగా ఉంటుంది.",null],["దుష్ప్రభావం","ఈ మందుకు దుష్ప్రభావాలు లేవు.",null],["సాధారణ","సాధారణ కస్టమర్లు ఇటువైపు.",null],["కూర్చు","కథలను కూర్చి పుస్తకం చేశారు.",null],["దగ్గరకు వెళ్ళు","నిశ్శబ్దంగా దగ్గరకు వెళ్లాను.",null],["వంచు","తల వంచి నమస్కరిస్తాను.",null],["మెలివేయు","దారాన్ని మెలివేస్తాను.",null],["భద్రత","భద్రత కట్టుదిట్టంగా ఉంది.",null],["సంబంధ తెగడం","రెండు తరాల మధ్య సంబంధ తెగడం పెద్దది.",null],["తోసుకుంటూ వెళ్ళు","మంచు దారిని తోసుకుంటూ వచ్చాను.",null],["ధారాళంగా","అన్నంపై సాస్ ధారాళంగా పోశాను.",null],["పదుల కొద్దీ","పదుల కొద్దీ మంది వచ్చారు.",null],["గట్టిగా ఉండు","రొట్టె గట్టిగా ఉంది.",null],["మధ్యేమార్గం","రెండు అభిప్రాయాల మధ్య మధ్యేమార్గం అవసరం.",null],["ప్రాతినిధ్యం వహించు","పాఠశాలకు ప్రాతినిధ్యం వహిస్తారు.",null],["దుఃఖించు","మరీ ఎక్కువగా దుఃఖించవద్దు.",null],["పక్కపక్కన","ఇద్దరూ పక్కపక్కన నడిచారు.",null],["సాధారణంగా ఉండు","సాధారణమైన రోజు.",null],["శుభ్రంగా","చేతులు శుభ్రంగా కడుక్కోండి.",null],["తొడిగించు","పిల్లవాడికి బట్టలు తొడిగించాను.",null],["అయ్యయ్యో","అయ్యయ్యో, ఈరోజు కష్టంగా ఉంది.",null],["ఎలా","ఇలా ఎలా జరుగుతుంది?",null],["నల్లగా ఉండు","ఆకాశం కారునలుపుగా ఉంది.",null],["జాగ్రత్త వహించు","మెట్లపై జాగ్రత్త వహించండి.",null],["ఇప్పుడే వినడం","అది నేను ఇప్పుడే వింటున్నాను.",null],["తెలియబడు","వార్త విస్తృతంగా తెలిసింది.",null],["భయంకరంగా ఉండు","భయంకరమైన ప్రమాదం.",null],["బయటపెట్టు","మనసులో మాట బయటపెట్టాను.",null],["బోర్లా పడుకో","నేలపై బోర్లా పడుకున్నాను.",null],["అయినప్పటికీ","ఆలస్యమైనా వచ్చాను.",null],["శాశ్వతంగా","శాశ్వతంగా గుర్తుంచుకుంటాను.",null],["ఊగు","బస్సు బాగా ఊగుతోంది.",null],["బహుశా","బహుశా వర్షం పడుతుంది.",null],["ఇక్కడా అక్కడా","ఇక్కడా అక్కడా వెతికాను.",null],["అంటే","రేపు, అంటే శనివారం కలుద్దాం.",null],["ప్రవర్తించు","మా తమ్ముడు బుద్ధిగా ప్రవర్తిస్తాడు.",null],["నిర్ణయించబడటం","సమావేశ సమయం నిర్ణయించబడింది.",null],["ప్రకటించు","ఫలితాలు ప్రకటించారు.",null],["పస్తు ఉండు","అల్పాహారం మానేశాను.",null],["నిర్మాణం","భవనం నిర్మాణం సరళంగా ఉంది.",null],["నిశితంగా ఉండు","స్వభావం నిశితంగా ఉంటుంది.",null],["మొదటి ప్రేమ","మొదటి ప్రేమను ఇప్పటికీ గుర్తుంచుకుంటాను.",null],["వింతగా ఉండటం","పిల్లవాడు ఒక వింత ప్రశ్న అడిగాడు.",null],["పెరుగు","కస్టమర్ల సంఖ్య పెరిగింది.",null],["వెళ్ళిపో","పడవ వెళ్ళిపోయింది.",null],["ముందుకు వచ్చు","నేనే ముందుగా ముందుకు వచ్చాను.",null],["చూడు","మాన్యువల్ చూడండి.",null],["మూర్ఖంగా ఉండు","అది మూర్ఖపు నిర్ణయం.",null],["అమ్మో","అమ్మో, నిజమా?",null],["తగ్గించు","దయచేసి కుర్చీని కొంచెం తగ్గించండి.",null],["కషాయం కాచు","మూలికా మందును కాచుతాను.",null],["ఆక్సిజన్","ఆక్సిజన్ సరిపోవడం లేదు.",null],["కడుపు నిండా","కడుపు నిండా తినండి.",null],["ఆరవేయు","బట్టలు ఆరవేస్తాను.",null],["ఏదైనా","ఏదైనా అడగండి.",null],["డైపర్","డైపర్ మారుస్తాను.",null],["కేవలం","కేవలం ఒక్కటే ఉంది.",null],["బతికి బట్టకట్టు","చివరి వరకు బతికి బట్టకట్టాను.",null],["దర్యాప్తు చేయు","కేసును దర్యాప్తు చేస్తున్నారు.",null],["భయమేయు","కుక్క మొరిగినందుకు భయమేసింది.",null],["విచారణ","విచారణ జరిగింది.",null],["సాధారణంగా ఉండు","ఇలాంటివి సాధారణమే.",null],["ముంచుకు రా","పరీక్ష ముంచుకు వచ్చింది.",null],["తలకిందులుగా","అక్షరాలు తలకిందులుగా రాశాను.",null],["తీవ్రంగా ఉండు","సమస్య తీవ్రంగా ఉంది.",null],["పనిచేయు","యంత్రం బాగా పనిచేస్తోంది.",null],["చల్లగా ఉండు","ఉదయపు గాలి చల్లగా ఉంది.",null],["కష్టం మీద కష్టం","ఆలస్యమైంది, దానిపైన వర్షం కూడా పడింది.","అక్షరాలా \"మంచుపై మంచు కురవడం\". ఒక కష్టం సాగుతుండగా మరొకటి రావడం — తెలుగులో \"కష్టం మీద కష్టం\"."],["కాల్చివేయు","ఉత్తరాన్ని కాల్చివేశాను.",null],["సమతూకంగా","కూరగాయలు కూడా సమతూకంగా తినండి.",null],["ప్రశ్నకు సంబంధం లేని జవాబు","నా ప్రశ్నకు సంబంధం లేని జవాబులే ఇచ్చారు.","అక్షరాలా \"తూర్పు అడిగితే పడమర చెప్పడం\". ప్రశ్నకు ఎలాంటి సంబంధం లేని జవాబు — సాధారణంగా కొంత విసుగుతో అంటారు."],["ఎలాగైనా","ఎలాగైనా వెళ్ళాలి.",null],["ముద్దు పెట్టు","నుదుటిపై ముద్దు పెట్టాను.",null],["అంగీకరించు","నా తప్పును అంగీకరించాను.",null],["మరణం","మరణ కారణాన్ని దర్యాప్తు చేస్తున్నారు.",null],["లొంగిపో","చివరకు లొంగిపోయారు.",null],["దాచిపెట్టు","మనసును దాచిపెట్టాను.",null],["లక్షలాది","లక్షలాది మంది చూస్తారు.",null],["ఎండ కాచుకో","ఎండ కాచుకుంటాను.",null],["ఉనికిలో ఉండు","అలాంటి ప్రదేశం ఉనికిలో ఉందా?",null],["కారు","పైకప్పు నుంచి నీరు కారుతోంది.",null],["దాటిపో","దుకాణాన్ని దాటిపోయాను.",null],["తమ్ముడు","తమ్ముడు అన్నను అనుసరిస్తాడు.",null],["గంభీరంగా ఉండు","ముఖకవళికలు గంభీరంగా ఉన్నాయి.",null],["పైగా","నేను ఆలస్యం అయ్యాను. పైగా వర్షం కురుస్తోంది.",null],["సన్నగా ఉండటం","ఈ దారం చాలా సన్నగా ఉంది.",null],["మంచికి మరింత మంచి","చౌక కూడా, రుచి కూడా — మంచికి మరింత మంచి.","అక్షరాలా \"పట్టుపై పూలు కూర్చడం\". ఇప్పటికే బాగున్నది మరింత బాగవడం — తెలుగులో \"మంచికి మరింత మంచి\"."],["దాడి చేయు","శత్రువుపై దాడి చేశారు.",null],["ఆహా","ఆహా, నిజంగా అందంగా ఉంది.",null],["పాతబడు","పాతబడిన బట్టలు పారేశాను.",null],["బలంగా ఉండు","బలమైన గాలి వీస్తోంది.",null],["తేలేలా వదులు","నదిలో పడవను వదిలాను.",null],["తరలిపో","వేరే గదికి వెళ్దాం.",null],["గొడవపడు","స్నేహితుడితో గొడవపడ్డాను.",null],["విడాకులు తీసుకో","వాళ్లిద్దరూ విడాకులు తీసుకున్నారు.",null],["చెల్లించు","కార్డుతో చెల్లించాను.",null],["అత్యుత్తమంగా ఉండటం","మార్కులు అత్యుత్తమంగా ఉన్నాయి.",null],["క్లుప్తంగా","క్లుప్తంగా చెబుతాను.",null],["మోచేయి","మోచేయి కొట్టుకుంది.",null],["ఒకేసారి","సామాన్లు ఒకేసారి తరలించాను.",null],["అసలే","అసలే చేయలేను.",null],["పగలగొట్టు","కిటికీని పగలగొట్టారు.",null],["భాగస్వామి","భాగస్వామితో కలిసి పనిచేస్తాను.",null],["కదలకుండా ఉండు","కాసేపు కదలకుండా ఉండండి.",null],["తేలికపాటి రుచిగా ఉండు","ఈ సూప్ తేలికపాటి రుచితో ఉంది.",null],["అద్భుతంగా ఉండు","అద్భుతమైన వార్త.",null],["బాధితుడు","బాధితుడికి సాయం చేస్తాం.",null],["తుంచు","పూలను తుంచవద్దు.",null],["కాపాడుకో","ఆరోగ్యాన్ని కాపాడుకుంటాను.",null],["గాయం","అదృష్టవశాత్తు తీవ్రమైన గాయాలు లేవు.","ఆసుపత్రిలో ఇది శారీరక గాయం. దుకాణంలో అదే పదం అప్పుపై కొనడాన్ని సూచిస్తుంది — 외상으로 사다, అప్పుపై కొనడం — రోజువారీ జీవితంలో ఈ అర్థమే ఎక్కువగా తగులుతుంది."],["తిరిగి పొందు","ఆరోగ్యాన్ని తిరిగి పొందాను.",null],["జాంగి","తాతయ్య జాంగి ఆడతారు.",null],["పట్టుకో","చేయి పట్టుకున్నాను.",null],["చెందు","నేను ఈ జట్టుకు చెందుతాను.",null],["సంకేతంగా ఉండు","పావురం శాంతికి సంకేతం.",null],["ఆటపట్టించు","స్నేహితుడిని ఆటపట్టించవద్దు.",null],["కేక","కేక వినిపించింది.",null],["వైద్య సేవలు","వైద్య సదుపాయాలు బాగున్నాయి.",null],["ఎందుకని","ఎందుకని ఈరోజు నిశ్శబ్దంగా ఉంది?",null],["సరే","సరే, అలాగే చేద్దాం.",null],["వేరుగా","వేరే మార్గం లేదు.",null],["వ్యూహం","వ్యూహం రూపొందించాం.",null],["శాంతించడం","చాలాసేపటికి నా ప్రశాంతతను తిరిగి పొందాను.",null],["చికిత్స చేయు","గాయానికి చికిత్స చేశారు.",null],["నడుపు","విమానాన్ని నడుపుతారు.",null],["స్పానిష్","స్పానిష్ నేర్చుకుంటాను.",null],["పూర్తి","పని పూర్తయింది.",null],["అసాధారణమైన","అసాధారణమైన వేడి కొనసాగింది.",null],["ఎలాగూ","ఎలాగూ ఆలస్యమైంది.",null],["ఏమైనప్పటికీ","ఈరోజు కుదరదు అనిపిస్తోంది.",null],["పొంగిపొర్లు","కప్పులో నీళ్లు పొంగిపొర్లాయి.",null],["అభ్యర్థించు","సాయం అభ్యర్థించాను.",null],["గరిష్ఠం","గరిష్ఠంగా పది మంది.",null],["కలిగి ఉండు","రవాణా ఖర్చుతో కలిపి ముప్పై వేల వాన్.",null],["చురుకుగా ఉండటం","పిల్లవాడు చాలా చురుకుగా ఉంటాడు.",null],["తప్పిపోయిన పిల్లవాడు","తప్పిపోయిన పిల్లవాడిని వెతుకుతున్నారు.",null],["సిగ్గుపడు","తప్పు చేసినందుకు సిగ్గుపడుతున్నాను.",null],["రాక్షసుడు","కథలో ఒక రాక్షసుడు వస్తాడు.",null],["మద్దతు","నాకు చాలా మంది మద్దతు లభించింది.",null],["పాకు","పాప గదిలో పాకుతోంది.",null],["అనుమతి లేకుండా","అనుమతి లేకుండా లోపలికి రావద్దు.",null],["తొలిదశ","మొదట్లో కష్టంగా ఉండేది.",null],["సంక్రమణ","సంక్రమణను అడ్డుకుంటాం.",null],["ప్రతిబింబింపజేయు","అభిప్రాయాలు ప్రతిబింబించేలా ప్రణాళికను సవరించాం.",null],["కనీసం","కనీసం రెండు రోజులు పడుతుంది.",null],["వైద్య శాస్త్రం","వైద్య శాస్త్రం చదువుతాను.",null],["ఇద్దరూ సంపాదించడం","నేను, నా జీవిత భాగస్వామి ఇద్దరమూ పనిచేస్తాం.",null],["శాఖ","దారి రెండుగా చీలుతుంది.",null],["ప్రయోగం","రాకెట్ ప్రయోగాన్ని చూశాను.",null],["దెయ్యం","దెయ్యం కథ విన్నాను.",null],["భయపడు","భయపడకండి.",null],["రుణపడి ఉండటం","మీకు రుణపడి ఉన్నాను.",null],["వృథా అనిపించు","పారేయడానికి మనసొప్పడం లేదు.",null],["పెంచు","సాధన సమయాన్ని పెంచాను.",null],["రాకపోకలు సాగించు","జనం రాకపోకలు సాగిస్తున్నారు.",null],["తొలగింపు","మరక తొలగించడం కష్టం.",null],["పట్టుదలతో ఉండు","పట్టుదలతో కృషి చేశాను.",null],["అడుగు వేయు","మెట్లపై జాగ్రత్తగా అడుగు వేయండి.",null],["బాధ్యత","బాధ్యత నాదే.",null],["తరమబడు","సమయం తరుముతోంది.",null],["నిర్వహించు","పనిని త్వరగా నిర్వహించాను.",null],["ప్రయత్నించు","మరోసారి ప్రయత్నించాను.",null],["సన్నద్ధమవు","తుఫానుకు సన్నద్ధమవుతున్నాం.",null],["మాట","ఒక్క మాట మాత్రం చెబుతాను.","చెప్పే చిన్న విషయం — 한 마디만 할게요, ఒక్క మాట చెబుతాను. అదే నామవాచకం కీలు లేదా కణుపును కూడా సూచిస్తుంది: వేలి కణుపు, వెదురు కణుపు, సంగీతంలో ఒక తాళ విభాగం."],["పట్టుదలగా ఉండు","ఆ ఆటగాడు నిజంగా పట్టుదల గలవాడు.",null],["కలిగి ఉండు","విలువైన వస్తువును కలిగి ఉన్నాను.",null],["నిబ్బరంగా ఉండు","నిబ్బరంగా మాట్లాడారు.",null],["అంతరంగం","ఆమె అంతరంగం అందమైనది.",null],["ఒక్కటే అయి ఉండు","అదొక్కటే మార్గం.",null],["చూస్తుంటే","చూస్తుంటే మీరు చాలా బిజీగా ఉన్నారు.",null],["నాయకుడు","ఆయనే మా నాయకుడు.",null],["అసలే","అసలే వెళ్ళలేదు.",null],["వెల్లడించు","నిజాన్ని వెల్లడించారు.",null],["మిక్కిలి","మిక్కిలి చల్లగా ఉంది.",null],["మానేయు","ఊరికే మానేస్తాను.",null],["కఠినంగా ఉండు","ఉపాధ్యాయుడు కఠినంగా ఉంటారు.",null],["ఆగ్రహం","ఆగ్రహాన్ని అణచుకున్నాను.",null],["ఉపయోగం","దీనికీ ఉపయోగం ఉంది.",null],["కలుపు","తీగను కలిపాను.",null],["అంతకంటే","అంతకంటే నడిచే వెళ్తాను.",null],["లోపలి భాగం","భవనం లోపలి భాగం విశాలంగా ఉంది.",null],["నిర్వహించు","జాగ్రత్తగా నిర్వహించండి.",null],["నిరుపయోగంగా ఉండు","ఇది నిరుపయోగమైన వస్తువు కాదు.",null],["తెలివైనదిగా ఉండు","అది తెలివైన ఎంపిక.",null],["కాబట్టి","మంచు కురిసింది. కాబట్టి రోడ్డు జారుతుంది.",null],["ఊరు","క్యాబేజీ బాగా ఊరింది.",null],["చింపు","కాగితాన్ని చింపాను.",null],["సంభవించు","ఒక సమస్య సంభవించింది.",null],["వివరంగా ఉండు","వివరణ వివరంగా ఉంది.",null],["దారి తప్పి తిరుగు","దారి తెలియక చాలాసేపు తిరిగాను.",null],["ధర్మం","అదే మనిషి ధర్మం.",null],["చివరికి","చివరికి రాత్రి కూడా పనిచేస్తారు.",null],["ఉడకకపో","అన్నం ఉడకలేదు.",null],["లేపి నిలబెట్టు","పడిపోయిన పిల్లవాడిని లేపి నిలబెట్టాను.",null],["అరెస్టు","నేరస్థుడి అరెస్టు వార్త విన్నాను.",null],["సంతోషంగా ఆహ్వానించు","కుక్కపిల్ల నన్ను సంతోషంగా ఆహ్వానిస్తుంది.",null],["నిరంతరంగా","నేను ప్రతిరోజూ నిరంతరంగా సాధన చేస్తాను.",null],["యోగా","ఉదయం యోగా చేస్తాను.",null],["అంశం","మూడు అంశాలూ అవసరం.",null],["ఢీకొను","మా భుజాలు ఢీకొన్నాయి.",null],["ఉత్సాహంగా ఉండు","ఉత్సాహభరిత స్వరంతో మాట్లాడారు.",null],["పొరలుగా వేసుకో","చల్లగా ఉండటంతో బట్టలు పొరలుగా వేసుకున్నాను.",null],["తప్పనిసరిగా జరిగే","రుసుము పెంపు తప్పనిసరిగా జరిగేదే.",null],["రాత్రంతా మేల్కొను","రాత్రంతా మేల్కొని ఉన్నాను.",null],["కనిష్ఠం","కనిష్ఠంగా గంట పడుతుంది.",null],["శుభాకాంక్షలు","రేపటి పరీక్షకు శుభాకాంక్షలు!",null],["అనుమతి","అనుమతి పొందాను.",null],["ప్రసంగం","ప్రసంగం పొడవుగా ఉంది.",null],["వృథా చేయు","సమయం వృథా చేయవద్దు.",null],["దూరమవు","శబ్దం క్రమంగా దూరమైంది.",null],["గర్భం దాల్చు","పెళ్లయ్యాక గర్భం దాల్చింది.",null],["ఇచ్చివేయు","నా స్థానాన్ని ఇచ్చివేశాను.",null],["అర్థమివ్వు","అది దేనికి అర్థమిస్తుంది?",null],["కుట్టి బాగుచేయు","బట్టలు కుట్టాను.",null],["అడ్డుపడు","నా చదువుకు అడ్డుపడవద్దు.",null],["పాల్గొను","కార్యక్రమంలో పాల్గొన్నాను.",null],["చక్రం","చక్రం చిన్నది.",null],["బార్లా తెరుచు","నోరు బార్లా తెరవండి.",null],["అందించు","కంపెనీ భోజనం అందిస్తుంది.",null],["లేదా","బస్సులో లేదా మెట్రోలో వెళ్ళండి.",null],["గట్టిపడు","బియ్యం పిండి వంటకం గట్టిపడింది.",null],["సంకోచం లేకుండా","సంకోచం లేకుండా స్థానం ఇచ్చారు.",null],["ముదురుగా ఉండు","రంగు ముదురుగా ఉంది.",null],["తగినదిగా ఉండు","అది తగిన జవాబు.",null],["సిద్ధంగా ఉంచు","కావలసినవన్నీ సిద్ధంగా ఉంచాను.",null],["రహస్య విషయం","రహస్యాన్ని కాపాడాలి.",null],["విద్యుత్ సరఫరా","విద్యుత్ ఆన్ చేయండి.",null],["తొందరగా ఉండు","ఇంకా తొందరగానే ఉంది.","ఈ రాతను మూడు వేర్వేరు క్రియలు పంచుకుంటాయి: తొందరగా ఉండటం (아직 일러요), ఒక ప్రదేశానికి లేదా సంఖ్యకు చేరుకోవడం (정상에 이르다), ఎవరి గురించైనా ఫిర్యాదు చేయడం (선생님께 이르다). ఈ కార్డు మొదటిదాన్ని నేర్పుతుంది."],["స్టార్ట్ చేయడం","కారును స్టార్ట్ చేస్తాను.",null],["నిజంగా మొదలుపెట్టాక","నిజంగా మొదలుపెట్టాక సులభంగా అనిపించింది.",null],["రక్తం","రక్త పరీక్ష చేయించుకున్నాను.",null],["పీడనం","పీడనం ఎక్కువగా ఉంది.",null],["దినచర్య","నా దినచర్య సరళంగా ఉంటుంది.",null],["దేహదారుఢ్యం","దేహదారుఢ్యం పెద్దది.",null],["వెంబడించు","దొంగను వెంబడించారు.",null],["మనసు పారేసుకో","మొదటి చూపులోనే మనసు పారేసుకున్నాను.",null],["చిరాకు కలిగించు","వేచి ఉండటం చిరాకు కలిగిస్తుంది.",null],["అయితే మాత్రం","బాగుంది. అయితే సమయం లేదు.",null],["వెనుక అనుసరించు","కుక్కపిల్ల నిశ్శబ్దంగా వెనుక అనుసరించింది.",null],["వదిలేయు","ఒక వ్యక్తిని వదిలేశాను.",null],["కలుపు","రెండు తరగతులను కలిపారు.",null],["అంతగా","అంతగా చెప్పేదేమీ లేదు.",null],["దివాలా తీయు","దుకాణం దివాలా తీసింది.",null],["కుట్టు","బొత్తాము స్థానాన్ని కుట్టాను.",null],["క్షేమంగా ఉండు","అందరూ క్షేమంగా ఉన్నారు.",null],["పిలుపు","ఒక పిలుపు వచ్చింది.",null]]}

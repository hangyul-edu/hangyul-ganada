а","Я прибрав ванну кімнату.",null],["бути радим зустрічі","Приємно познайомитися.",null],["кров","З пальця йде кров.",null],["земля, ґрунт","Коли я торкаюся землі, мені добре.",null],["гострий перець","Перець дуже гострий.",null],["ферма","На фермі розводять корів.",null],["день тижня","Який сьогодні день тижня?",null],["словник","Я шукаю слово в словнику.",null],["екран","Екран яскравий.",null],["мати","У мене є олівець.",null],["щось безкоштовне","Це безкоштовно.",null],["кінотеатр","Я дивлюся фільм у кінотеатрі.",null],["номер","Скажіть номер, будь ласка.",null],["склад","Я поклав коробки на склад.",null],["плата, тариф","Плата за проїзд в автобусі зросла.",null],["подвір'я","Я граюся на подвір'ї.",null],["спальня","Будь ласка, залиште вікно спальні відчиненим.",null],["вибір","Це був важкий вибір.",null],["конверт","Я поклав листа в конверт.",null],["свинина","Ми посмажили свинину і з'їли її.",null],["купання","Перед сном я приймаю ванну.",null],["не дуже","Мені це не дуже подобається.",null],["спати (ввічливо)","Бабуся спить.",null],["аптека","Я купив ліки в аптеці.",null],["троянда","Троянди приємно пахнуть.",null],["суперник","У матчі ми зустріли сильного суперника.",null],["доросла людина","Я хочу стати дорослим.",null],["кола","Одну колу, будь ласка.",null],["розмова","Розмова була приємна.",null],["доставка","Доставка триває тридцять хвилин.",null],["правильна відповідь","Я дав правильну відповідь.",null],["фестиваль","Восени відбувається фестиваль.",null],["бути цікавим","Ця книжка цікава.",null],["щиколотка","Я підвернув щиколотку на сходах.",null],["білизна","Поклади білизну в шухляду.",null],["житло","Житло близько до вокзалу.",null],["палити","Ми палимо опале листя.",null],["огірок","Огірок освіжає.",null],["парфуми","Ці парфуми гарно пахнуть.",null],["неділя","У неділю я відпочиваю.",null],["місце проведення","Ми визначили місце.",null],["після довгого часу","Я зустрів друга після довгої перерви.",null],["голова","Я кивнув головою.",null],["функція"
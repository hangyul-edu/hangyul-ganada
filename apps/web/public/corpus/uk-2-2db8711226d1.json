я","Повітря чисте.",null],["підвал","Я поставив речі в підвал.",null],["аромат","Кімната сповнена аромату квітів.",null],["маска","Я вдягнув маску.",null],["рослина","Я поставив рослину біля вікна.",null],["жінка середнього віку","Пані дала мені суп.","Буденне, пряме слово на позначення жінки віку ваших батьків. Сказане просто їй, воно часто звучить як образа щодо віку. 아주머니 — ввічлива форма, а 저기요 обходить проблему."],["електронний лист","Я надіслав електронного листа.",null],["чи часом","Чи часом маєте час?",null],["зазвичай","Зазвичай я встаю о сьомій.",null],["бути (ввічливо)","Бабуся в кімнаті.",null],["всесвіт","Всесвіт дуже широкий.",null],["гриб","Я зварив суп із грибами.",null],["зачиняти","Я зачиняю двері.",null],["подавати старшому","Я підношу вчителеві подарунок.",null],["голос","У вас гарний голос.",null],["учитель","Той чоловік — учитель у школі.","Проста форма слова вчитель. На практиці корейці майже завжди кажуть 선생님, із шанобливим 님 — так до вчителя звертаються навіть інші дорослі. Саме лише 선생 може звучати різко."],["без","Я прийшов без грошей.",null],["колір","Мені подобається цей колір.",null],["звісно","Звісно, все гаразд.",null],["навчати","Я навчаю корейської.",null],["скеля, валун","Я сів на скелю.",null],["тло, фон","У фотографії гарний фон.",null],["церква","У неділю я ходжу до церкви.",null],["вимова","У вас дуже гарна вимова.",null],["розмовляти","Говоріть повільно, будь ласка.",null],["телевізор","Увечері я дивлюся телевізор.",null],["бути тихим","У бібліотеці тихо.",null],["землеробство","Мій дідусь займається землеробством.",null],["цибуля","Коли ріжу цибулю, сльозяться очі.",null],["обідня перерва","В обідню перерву я гуляю.",null],["район","Цей район тихий.",null],["торт","Я розрізав торт.",null],["копати","Я копаю землю.",null],["бути втомленим","Сьогодні я дуже втомився.",null],["бути теплим","Сьогодні тепла погода.",null],["пакет","Я поклав фрукти в пакет.",null],["в'язниця","Той чоловік десять років сидів у в'язниці.",null],["над
ια μου τρέμουν από το άγχος.",null],["είμαι σαφής","Η σημασία είναι σαφής.",null],["κολλάω","Κολλάω ένα γραμματόσημο.",null],["μπαταρία","Η μπαταρία τελείωσε.",null],["νοιάζομαι, σκοτίζομαι","Μην το σκέφτεστε τόσο πολύ, παρακαλώ.",null],["θερμοκρασία σώματος","Μετρήστε πρώτα τη θερμοκρασία, παρακαλώ.",null],["ευθεία, κατευθείαν","Στρίψτε δεξιά και συνεχίστε ευθεία.",null],["κοπιάζω, μοχθώ","Ευχαριστώ για τον κόπο σας.",null],["στοιβάζω","Στοίβαξα τα βιβλία.",null],["μένω ικανοποιημένος","Το αποτέλεσμα με ικανοποιεί.",null],["αγχώνομαι","Αγχώνομαι όταν στέκομαι μπροστά σε κόσμο.",null],["κούραση, κόπωση","Η κούραση συσσωρεύτηκε.",null],["είμαι απλός","Το σχήμα είναι απλό.",null],["ηχώ, χτυπώ","Η καμπάνα χτυπάει.",null],["ξεθάβω, βγάζω από τη γη","Βγάζω πατάτες από το χώμα.",null],["γαμπρός, άντρας της κόρης","Ο γαμπρός μου οδήγησε.",null],["είμαι τέλειος","Η προετοιμασία είναι τέλεια.",null],["κάποτε","Κάποτε ζούσα στο Πουσάν.",null],["βιαστικά","Βγήκα βιαστικά και ξέχασα την ομπρέλα μου.",null],["συνείδηση","Η συνείδησή μου δεν το επιτρέπει.",null],["είμαι αδιάθετος","Πού πονάτε;",null],["ηχογράφηση","Ακούστε την ηχογράφηση, παρακαλώ.",null],["είμαι τρυφερός, στοργικός","Η φωνή ακούγεται τρυφερή.",null],["επαναλαμβάνω","Επανέλαβα τα ίδια λόγια.",null],["ακίνητα, ήσυχα","Καθίστε ήσυχα, παρακαλώ.",null],["εντοπίζω, βρίσκω","Εντόπισα το χαμένο πορτοφόλι.",null],["γεράματα","Αποταμιεύω για τα γεράματά μου.",null],["αναφέρω","Ανέφερα το αποτέλεσμα.",null],["έτσι όπως είναι","Είναι εντάξει έτσι όπως είναι.",null],["αποχαιρετισμός","Αποχαιρετιστήκαμε στο αεροδρόμιο.",null],["ξαστερώνω, καθαρίζω","Ο καιρός καθάρισε.",null],["αποκλείεται, μη μου πεις","Μη μου πείτε ότι έφυγαν κιόλας;",null],["σπάζω στα δύο","Το μολύβι έσπασε.",null],["εξαπατώμαι, ξεγελιέμαι","Ξεγελάστηκα από ένα ψέμα.",null],["διώχνω","Μη διώχνετε τη γάτα, παρακαλώ.",null],["ασυλλόγιστα, αλόγιστα","Μην ξοδεύετε χρήματα ασυλλόγιστα.",null],["κρεμάω","Κρέμασα ένα φωτιστικό από το ταβάνι.",null],["αντιθέτως, απ
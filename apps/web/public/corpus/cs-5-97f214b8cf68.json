.",null],["být bídný, být zoufalý","Cítil jsem se zoufale.",null],["čekat v pohotovosti","Čekal jsem venku v pohotovosti.",null],["do posledního","Všechno se do posledního kusu prodalo.",null],["natáhnout, napřáhnout","Natáhl jsem ruku.",null],["celý průběh od začátku do konce","Krok za krokem jsem vysvětlil celý průběh.",null],["sdílet","Sdíleli jsme materiály.",null],["být elegantní","Pohybuje se elegantně.",null],["podporovat","Tu myšlenku podporuji.",null],["ustoupit, odstoupit","Ustoupil jsem o krok.",null],["úplná mlha, nic není jasné","Případ je stále zahalen mlhou.",null],["požádat o","Poprosil jsem o pomoc.",null],["předčasnost","Rozhodovat teď je předčasné.",null],["přítel od dětství","My dva jsme přátelé od dětství.",null],["vypracování se z ničeho","Ten člověk se vypracoval z ničeho a vybudoval velkou firmu.",null],["nerozhodnost","Pro samou nerozhodnost se pokaždé rozhodne pozdě.",null],["být bezmezný","Dostalo se mi bezmezné lásky.",null],["úzkostné strachování","Při čekání na výsledek jsem se užíral úzkostí.",null],["vžití se do druhého","Když se vžijete do druhého, pochopíte to.",null],["změna, která nic nemění","Tím se ve skutečnosti nic nemění.","Ošetřovatel řekl opicím, že ráno dostanou tři kaštany a večer čtyři; rozzuřily se. Nabídl čtyři ráno a tři večer a byly nadšené. Tak se říká dohodě přeskládané tak, aby jen vypadala lépe."],["vysoké jasné nebe podzimu","Je období vysokého jasného nebe.",null],["být nerozvážný, být riskantní","Bylo to nerozvážné chování.",null],["apelovat, dovolávat se","Apelovali na občany, aby pomohli.",null],["vrátit zpět","Vrátil jsem obrazovku zpět.",null],["ostře kritizovat, odsuzovat","Neodsuzujte druhé tak lehkovážně.",null],["být výhodný","Je to pro nás výhodné.",null],["svěsit se, klesnout","Ramena jim poklesla.",null],["vyrýt, vytesat","Vyryl jsem do dřeva jméno.",null],["viset, držet se","Dítě visí na hrazdě.",null],["ulovit a sežrat","Liška sežrala slepici.",null],["netrpělivé vyhlížení","Netrpělivě vyhlížím zprávu o úspěšném složení zkoušky.",null],["opatrování jako oka v hlavě","Maminka ten šálek opatruje jako oko v hlavě.",null],["důkladné rozvážení","Rozhodl jsem se po důkladném rozvážení.",null],["věc k ničemu","Bez elektřiny je to k ničemu.",null],["vymyslet si","Vymysleli si tu historku.",null],["udusat, upěchovat","Pevně udusali zem.",null],["dosáhnout, dorazit","Dosáhli jsme vrcholu.",null],["nevyzpytatelnost štěstí","Život je nevyzpytatelný.","Z příběhu o starci, jemuž utekl kůň: neštěstí se obrátilo ve štěstí a pak zase v neštěstí. Používá se, když ještě nelze poznat, zda je něco k dobrému, nebo ke zlému."],["explodovat, vybuchnout","Plyn vybuchl.",null],["kdo uzel uvázal, ať ho rozváže","Kdo ten uzel uvázal, měl by ho rozvázat.",null],["všestranné nadání","Je to všestranně nadaný člověk.",null],["běžný jev, nic ojedinělého","Takové věci se stávají běžně.",null],["připravenému se nic nestane","Připravenému se nic nestane, tak jsem se nachystal předem.","Doslova „je-li příprava, není starost“. Důvod udělat tu nudnou část předem. Objevuje se na bezpečnostních cedulích stejně jako v běžném hovoru."],["vykonat, splnit","Splnili svůj úkol.",null],["vstoupit, vkročit","Vkročil jsem do pokoje.",null],["vzájemná výpomoc","Sousedé si navzájem pomáhají.",null],["hladovět","Dlouho hladověli.",null],["číhání na příležitost","Celou dobu číhali na příležitost.",null],["osamělý boj","Sám jsem bojoval a udržel obchod v chodu.",null],["chrápat","Chrápe.",null],["být zbabělý","Byl to zbabělý čin.",null],["odpovědět, ozvat se","Nikdo neodpověděl.",null],["být politováníhodný, být škoda","Ten výsledek je škoda.",null],["hladký průběh bez zádrhelu","Porada proběhla bez jediného zádrhelu.",null],["být vhodný","Je to vhodný člověk na toto místo.",null],["kdo si co nadrobil, ten si to sní","Neučili se, tak si to nadrobili sami.","Doslova „vlastní skutek, vlastní zisk“. Následek, který si člověk přivodil sám. O druhém je to výtka, o sobě přiznání."],["zablokovat, uzavřít","Uzavřeli cestu.",null],["být důkladný","Příprava je důkladná.",null],["vrhnout se, skočit do","Skočil jsem do vody.",null],["peripetie","Po mnoha peripetiích jsem otevřel obchod.",null],["dvě mouchy jednou ranou","Tenhle způsob opravdu zabije dvě mouchy jednou ranou.","Čtyřznakový idiom přejatý z čínštiny: doslova „jeden kámen, dva ptáci“. Používá se přesně jako „dvě mouchy jednou ranou“ — o jednom činu, který se vyplatí dvakrát."],["pobíhání sem a tam","Celý den jsem kvůli přípravě akce pobíhal sem a tam.",null],["nacházet se","Škola se nachází na kopci.",null],["vrána k vráně sedá","Vrána k vráně sedá, a je to opravdu tak.",null],["cizí chyba jako vlastní poučení","I z cizích neúspěchů bychom si měli vzít poučení.",null],["usilovat o","Usiluji o štěstí.",null],["být protivný, být hnusný","Ten zápach je hnusný.",null],["mluvit otevřeně","Promluvme si otevřeně.",null],["pomstít se","Rozhodl jsem se nemstít.",null],["vyšetřovat","Policie vyšetřuje případ.",null],["ohrožovat, zastrašovat","Nezastrašujte lidi.",null],["dařit se, jít dobře","Obchodu se poslední dobou daří.",null],["smířit se s, vzít na sebe","Smířil jsem se se ztrátou.",null],["zradit, zklamat důvěru","Nechci zklamat přítelovu důvěru.",null],["být oprávněný","Je to oprávněný požadavek.",null],["stáhnout se, ustoupit","Armáda se stáhla.",null],["být domýšlivý, být nafoukaný","Chová se domýšlivě.",null],["být odporný","Je to odporný zápach.",null],["naprostá bezmoc","Proti té náhlé nehodě jsme byli bezmocní.",null],["sbírat","Sbírám známky.",null],["vyrašit","Vyrašily nové výhonky.",null],["navléknout","Navlékl jsem nit do jehly.",null],["vytahovat se, předvádět se","Před staršími se nevytahujte.",null],["navádět, ponoukat","Nenavádějte kamaráda.",null],["urážet","Neurážejte druhé.",null],["devět případů z deseti","V devíti případech z deseti to tak dopadne.",null],["rozkázat","Velitel vydal rozkaz.",null],["být nejednoznačný","Odpověď byla nejednoznačná.",null],["dráždit","Pálivé jídlo dráždí žaludek.",null],["velké
í jsou lístky vyprodané.",null],["oklepat, vytřepat","Oklepávám prach z oblečení.",null],["velkého formátu","Přijel velký autobus.",null],["odpor","Odpor obyvatel byl velký.",null],["provětrat se","Šel jsem se ven provětrat.",null],["zrušit rozhodnuté","Včerejší rozhodnutí jsme zrušili.",null],["vytřídit","Uchazeče jsme vytřídili podle dokladů.",null],["založení vlastního podniku","Začali podnikat s malým obchodem.",null],["odložit, zpomalit","Posunuli jsme čas na později.",null],["vystavení dokladu","Vystavení pasu trvá tři dny.",null],["vlastně, když se to tak vezme","Když se to tak vezme, je to vlastně pravda.",null],["čím dál víc","Je čím dál větší zima.",null],["být praktický a jednoduchý","Používá se snadno a rychle.",null],["řetězec, série","Došlo k řetězové nehodě.",null],["zhustit","Dlouhou zprávu jsme zhustili na dvě strany.",null],["označit, vyznačit","Vyznačil jsem to na mapě.",null],["celou dobu","Byl jsem tu celou dobu.",null],["spravovat, pečovat o","Dobře pečuji o své zdraví.",null],["srovnat, porovnat s","Ve srovnání s loňskem se to zlepšilo.",null],["umělý","Je tu umělé jezero.",null],["vhled","Ta kniha obsahuje hluboký vhled do lidské povahy.",null],["zasloužit se","Velmi jsme se zasloužili o rozvoj kraje.",null],["milion","Stálo to milion wonů.",null],["vyčíslit","Náklad jsme přesně vyčíslili.",null],["důrazně hájit","Důrazně jsme hájili význam vzdělání.",null],["pevně ustavit","Nové kritérium jsme pevně ustavili.",null],["pouze, prostě","Byl to jen omyl.",null],["prohloubit se","Rozdíl mezi kraji se prohloubil.",null],["předpokládat, očekávat","Ten výsledek jsem předpokládal.",null],["sevřít v náručí","Sevřel jsem dítě v náručí.",null],["zhruba","Přípravy jsou zhruba hotové.",null],["pustit ven","Pustil jsem kočku ven.",null],["osvojit si","Osvojil jsem si hangul.",null],["ztratit lesk","Význam toho slova ztratil lesk.",null],["na druhou stranu","Mám radost. Na druhou stranu mám i obavy.",null],["odmítnout","Odmítl jsem nabídku.",null],["být čel
{"band":1,"locale":"ky","words":[["нерсе","Керектүү нерселерди сатып алдым.","Кореянын эң көп кездешкен зат атоочу: сиз атабаган нерсенин ордуна турат. 제 것 — *меники*; 먹을 것 — *жей турган бир нерсе*. Оозеки тилде 거 болуп кыскарат — 이거, 그거, 저거 — жаңы үйрөнгөндөр адегенде ушул түрүн жолуктурат."],["кылуу","Мен сабак окуйм.","Кылуу — жана корей сөз жасоонун кыймылдаткычы. Аны зат атоочко кошсоңуз, этиш чыгат: 공부 (окуу) → 공부하다 (окуу, билим алуу), 사랑 (сүйүү) → 사랑하다. Жүздөгөн этиш ушинтип жасалган."],["унаа","Мен унаа менен барам.","Унаа. Ушул эле муун чай дегенди да билдирет: 차를 마셔요 — чай ичем, 차를 타요 — унаага отурам. Кайсынысы экенин этиш айтат."],["аял","Ал аял — дарыгер.",null],["акча","Капчыкта акча бар.",null],["бир жерде болуу","Мен үйдөмүн.","Кыргызчада эки сөз керек жерде корейчеде бирөө: 있다 — бир жерде болуу да, ээ болуу да. 책상에 책이 있어요 — китеп үстөлдө турат; 시간이 있어요 — убактым бар. Тескериси — 없다."],["сөз, айтылган сөз","Сөзүңдү байкап айт.","Сөз — бирөөнүн айтканы. Дал ошол муун ат дегенди да билдирет, ал эми 말 корей тили деген 한국말 сөзүн бүтүрөт. Жазууда аларды эч нерсе ажыратпайт: 말을 하다 — сүйлөө, 말을 타다 — атка минүү."],["мен","Мен корей тилин үйрөнүп жатам.",null],["Күн","Күн жаркырап турат.",null],["үй","Мен үйгө бара жатам.",null],["кол","Мен кол менен жазам.",null],["убакыт","Менин убактым жок.","Жалпы убакыт, ошондой эле сааттарды сануучу сөз: 두 시간 — эки саат. Аны 시 менен чаташтырбаңыз, ал — сааттагы убакыт: 두 시 — саат экиде, таптакыр башка нерсе."],["ооба","Ооба, туура.","네 деп жазылган үч кеңири сөз бар. Бул — «ооба». Калгандары «сенин» (네 책, сенин китебиң) жана эсептик сөздүн алдында турган «төрт» (네 개, төрт даана). Аларды жазылышы эмес, контекст ажыратат."],["ит","Ит чуркап баратат.",null],["куш","Куш учуп баратат.",null],["эшик","Мен эшикти ачам.",null],["мүнөт","Он гана мүнөт күтө туруңуз.","Дагы эки сөз 분 болуп жазылат. Бири — адамдарды сылык санаган ыкма: 세 분, үч киши, конокторго же улууларга карата. Экинчиси ачууну билдирет, 분이 풀리다 дегендей. Аларды сүйлөм гана ажыратат."],["дене","Мен күн сайын денемди жуум.",null],["бөлмө","Бөлмө таза.",null],["арт жагы","Дептердин артына атымды жаздым.",null],["көз","Сенин көздөрүң сулуу.","Көз. Кар деген сөз менен бирдей жазылат; кылдат сүйлөгөндө аларды узундугу айырмалайт: кардын 눈-у созулуп, көздүн 눈-у кыска айтылат. Көпчүлүк контекстке таянат."],["биз","Биз досбуз.",null],["кийим","Кийим сулуу.",null],["баруу","Мен мектепке барам.",null],["баш","Башым ооруп жатат.",null],["жамгыр","Жамгыр жаап жатат.",null],["ооз","Ооз кичинекей.",null],["суу","Мен суу ичем.",null],["бут","Бутум ооруйт.","Бут — сиздики, үстөлдүкү, отургучтуку. Ушул эле сөз «көпүрө» дегенди да билдирет, ошондуктан 다리를 건너요 — «көпүрөдөн өтөм», денеге тиешеси жок."],["мектеп","Мектеп чоң.",null],["бет","Мен бетимди жуум.",null],["саат","Сабак саат экиде бүтөт.","Саат төл сан атоочторду алат — 한 시, 두 시, 세 시 — ал мүнөт кытай тектүүлөрүн: 세 시 십 분, үчтөн он мүнөт өткөн. Экөөнү алмаштырып алуу — жаңы үйрөнгөндүн классикалык катасы, дароо угулат."],["сен","Сен кайдасың?",null],["кол","Сенин колдоруң узун.",null],["жок болуу","Менде акча жок.",null],["мен (сылык)","Мен студентмин.",null],["ыр","Мен ыр ырдайм.",null],["дагы, көбүрөөк","Дагы бир аз бериңизчи.",null],["китеп","Мен китеп окуйм.",null],["Ай","Ай жарык.",null],["телефон","Мен телефонго жооп берем.",null],["дарак","Дарак бийик.",null],["көрүү","Мен кино көрөм.",null],["бир күн","Күн узун.",null],["адам","Ал жакшы адам.",null],["бул жерде","Бул жерге отуруңуз.",null],["эмнеге","Эмнеге кечиктиң?",null],["алды жагы","Дүкөндүн алдында жолугалы.",null],["дүйнө","Дүйнө кенен.",null],["кечигүү","Автобус кечикти.",null],["таман","Бутум тоңуп калды.",null],["күн","Бүгүн жакшы күн.",null],["мурун","Мурдум бүтөлүп калды.",null],["сүрөт","Мен сүрөткө тартам.",null],["керебет","Керебет ыңгайлуу.",null],["тоо","Мен тоого барам.",null],["белек","Мага белек жагат.",null],["баары","Күрүчтү толугу менен жеп койдум.",null],["азыр","Мен азыр барам.",null],["ооруқана","Мен ооруканага барам.",null],["баары","Баары чогулду.",null],["сумка","Сумка оор.",null],["музыка","Музыка сонун.",null],["түштөн кийин","Түштөн кийин жолугалы.",null],["дүкөн","Дүкөн жабык.",null],["бир аз, ошондой эле өтүнүчтү жумшартчу сөз","Бир аз суу бериңизчи.","조금 сөзүнүн кыскасы, *бир аз* — бирок ишинин жарымы жумшартуу. Өтүнүчкө кошулса, курчтугун алат: 도와주세요 — *жардам бер*, 좀 도와주세요 — *жардам бере аласызбы* дегенге жакын. Корейлер аны так ошол себептен тынымсыз колдонот."],["мурун","Тамактанардын алдында колумду жуум.","Убакыт маанисинде мурун. Дагы бир нече сөз 전 болуп жазылат: 전쟁 — согуш, кыскарганда 전; 전기 — электр; ал эми менюдагы 전 — тузд куймак. Этиштин алдында турганда бул убакытка тиешелүүсү — 먹기 전에, тамактанардан мурун."],["жол","Жол кең.",null],["кулак","Кулагым ооруйт.",null],["кофе","Мен кофе ичем.",null],["автобус","Автобус келе жатат.",null],["сүрөт","Мен сүрөт тартам.",null],["тамак","Мен тамак ичем.",null],["бүгүн","Бүгүн аба ырайы жакшы.",null],["арак","Мен арак ичпейм.",null],["чын эле","Чоң рахмат.","Чын эле, чынында — сын атоочтун алдында турган күчөтүүчү сөз: 정말 좋아요. Жалгыз турганда, аягын көтөрүп айтса, 정말? бир сөздүк суроо болот: «чынбы?» — көбүнчө ушинтип угасыз."],["бир","Бир алма бериңизчи.",null],["кино","Кино кызык.",null],["жолу","Дагы бир жолу кылыңызчы.",null],["учак","Мен учак менен учам.",null],["келүү","Досум келе жатат.",null],["жылдыз","Жылдыздар жаркырап турат.",null],["сатып алуу","Мен нан сатып алам.",null],["апам","Апам тамак жасап жатат.",null],["дары","Тамактан кийин дары ичиңиз.",null],["билүү","Бул ысымды билем.",null],["эт","Мен эт куурам.",null],["алма","Алма таттуу.",null],["деңиз","Деңиз кең.",null],["сырт","Сыртта жамгыр жаап жатат.",null],["асман","Асман көк.",null],["баш кийим","Мен баш кийим кийем.",null],["буюм","Мен буюм сатып алам.",null],["жакшы болуу","Көңүлүм жакшы.",null],["жакшы","Жакшы уктадыңбы?",null],["дос","Мен дос менен жолугам.",null],["бут кийим","Мен бут кийим кийем.",null],["бир нерсе эмес болуу","Мен студент эмесмин.","이다 сөзүнүн карама-каршысы. Танылган нерсеге 을/를 эмес, 이/가 жалганат: 학생이 아니에요, эч качан 학생을 아니에요 эмес. Ушул бир үлгүнү үйрөнгөн адам корей тилиндеги ар кандай атоочтук сүйлөмдү танып сала алат."],["туулган күн","Туулган күнүң менен.",null],["беш","Беш киши келди.",null],["базар","Мен базардан жашылча алам.",null],["от","Тоодо өрт чыкты.",null],["тамак","Корей тамагы даамдуу.",null],["мүмкүнчүлүк","Бул жакшы мүмкүнчүлүк.",null],["мышык","Мышык уктап жатат.",null],["атам","Жакшы жат, ата.",null],["жай","Жайында мен деңизге барам.",null],["чын","Бул чынбы?",null],["терезе","Терезени жабыңызчы.",null],["бир аз","Бир аз күтө туруңуз.",null],["эркек","Ал эркек менин досум.",null],["отургуч","Отургучта отурам.",null],["сүт","Сүт муздак.",null],["жаныбар","Мен жаныбарларды жакшы көрөм.",null],["эки","Эки отургуч бар.",null],["жеш","Мен жемиш жейм.",null],["нан","Мен нан жейм.",null],["саякат","Мен саякаттагым келет.",null],["бир нерсе болгон учур","Бала кезимде айылда жашачумун.",null],["жумуш","Бүгүн жумуш көп.","Жумуш же аткарылууга тийиш иш. Дал ошол муун кытай тектүү бир — 일 번, биринчи номер — жана ал 일요일 болгон жекшембидеги күн, ошондой эле 삼 일, үч күн."],["шым","Шым узун.",null],["саат","Менде саат жок.",null],["түн","Түндө жылдыз көп.","Түн. «Каштан» деген сөз менен бирдей жазылат, ал эми каштан Кореяда — күздүн кадимки тамагы. Ошондуктан 밤을 먹어요 менен 밤에 자요 таптакыр башка нерсе жөнүндө."],["сынак","Эртең сынагым бар.",null],["аба ырайы","Аба ырайы жакшы.",null],["компьютер","Компьютерди күйгүзөм.",null],["кагаз","Кагазга сүрөт тартам.",null],["шаар","Шаар абдан чоң.",null],["жаз","Жазында гүлдөр ачылат.",null],["үстү","Баштыктын үстүндө калпак бар.",null],["көйгөй","Бир көйгөй бар.",null],["кечки тамак","Кечки тамакты жейм.",null],["түс","Бул түс кооз.",null],["кыш","Кышында кар көп жаайт.",null],["ата","Атам жумушка барат.",null],["кириңиз, тезирээк","Кош келиңиз, кириңиз.",null],["жашоо","Мен Сеулда жашайм.",null],["каалаганы менен кыла албоо","Өтө ачуу, ошондуктан жей албайм.","Корей тилинде эки танык бар, алар ар башка нерсе айтат. 안 — *каалабайм*; 못 — *колумдан келбейт*. 안 먹어요 — жебөөнү тандап жатасыз; 못 먹어요 — бир нерсе тоскоол болууда. Дал ошондой жазылган 못 зат атоочу — мык."],["түшкү тамак","Чогуу түшкү тамак жейли.",null],["бала","Бала күлүп жатат.",null],["ким","Ал киши ким?",null],["качан","Сен качан келесиң?",null],["кайра","Кайра айтыңызчы.",null],["көчө","Көчөдө адам көп.",null],["кээде","Кээде кино көрөм.",null],["юбка","Бул юбка абдан кооз.",null],["көп болуу","Адам көп.",null],["тигинде","Тигинде мектеп бар.",null],["парк","Паркта басам.",null],["күрүч","Күрүчтү жууп бышырам.",null],["Жер","Жер тегерек.",null],["дубал","Дубалга сүрөт илем.",null],["жумуртка","Эртең менен жумуртка бышырдым.",null],["кайда","Даараткана кайда?",null],["унаага түшүү","Автобуска түшөм.","Сени алып жүргөн ар нерсеге минүү — автобуска, велосипедге, лифтке. Дагы эки абдан кеңири этиш ушул жазуу менен орток: 타다 күйүү дегенди да, суусундукка бир нерсе аралаштыруу дегенди да билдирет."],["дүйнө","Дүйнөнүн көп өлкөсүн билем.",null],["шорпо","Эртең менен шорпо ичем.",null],["ысым","Сенин атың ким?",null],["сүйлөө","Жайыраак сүйлөңүзчү.",null],["жөө басуу","Паркта жөө басам.",null],["күчүк","Күчүк кичинекей.",null],["жаны","Жаныма отуруңузчу.",null],["үн","Үн катуу.",null],["ой","Бул жакшы ой.",null],["ошол жерде","Ошол жерде бирөө барбы?",null],["кафе","Досум менен кафеде жолугам.",null],["уул","Уулум мектепке барат.",null],["топ","Топту тебем.",null],["айыл","Айыл тынч.",null],["үй-бүлө","Үй-бүлөм чоң.",null],["болуу","Дарыгер болгум келет.","Болуу. Бул ошондой эле бир нерсенин иштеп жатканын же уруксат экенин билдирген күнүмдүк сөз: 안 돼요 — андай болбойт, 다 됐어요 — бүттү. Аларды сөздүктөгү маанисинен алда канча көп угасыз."],["ысымдан кийин колдонулуучу сылык сөз","Минсу, бир мүнөт.","Атка жалганса, тең адамдардын ортосунда сылык жана жылуу угулат: 민수 씨. Фамилияга гана жалганса — 김 씨 — алыс, атүгүл орой чыгат, ошондук
ere","Ho letto saltando una riga.",null],["confidare, aprirsi","Ho confidato le mie preoccupazioni.",null],["il troppo stroppia","Anche con l’esercizio, il troppo stroppia.",null],["girare, capovolgere","Giro la frittella.",null],["essere scattante","I suoi movimenti sono scattanti.",null],["negare","Hanno negato l’accusa.",null],["abbandono di sé, disperazione totale","Non si lasci andare alla disperazione.",null],["avvertire, mettere in guardia","Hanno messo in guardia dal pericolo.",null],["negare, smentire","Hanno negato i fatti.",null],["guadagno del terzo che guarda","Mentre le due aziende litigavano, il vantaggio è andato a noi.",null],["prendere in considerazione","Ho tenuto conto del tempo atmosferico.",null],["ereditare","Ho ereditato l’anello di mia nonna.",null],["restare in attesa","Ho aspettato fuori.",null],["essere composto e garbato","Ha un modo di parlare garbato.",null],["puzzare","C’è una puzza terribile.",null],["dire paragonando ad altro","Ha parlato della vita paragonandola a un viaggio.",null],["giurare","Ho giurato che non l’avrei mai più fatto.",null],["avvicinarsi","Ci siamo avvicinati con cautela.",null],["essere debole di carattere","Ho abbandonato ogni debolezza d’animo.",null],["senza sosta","Ho fatto pratica senza sosta.",null],["bruciare, dolere","Mi brucia lo stomaco.",null],["essere frenetico","Oggi è una giornata frenetica.",null],["firmare","Firmi qui, per favore.",null],["dominare","Hanno dominato un vasto territorio.",null],["dimostrare, provare","Ho dimostrato la verità dei fatti.",null],["appoggiarsi a","Cammina appoggiandosi al bastone.",null],["storia intera dall’inizio alla fine","Ho spiegato l’intera vicenda passo per passo.",null],["essere soltanto, non più di","Sono soltanto dieci persone.",null],["affrontare, tenere testa a","Ho tenuto testa alle difficoltà.",null],["mistero fitto","Il caso è ancora avvolto nel mistero.",null],["calpestare","Non calpesti l’aiuola, per favore.",null],["sostenere, appoggiare","Io appoggi
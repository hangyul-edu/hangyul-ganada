{"band":2,"locale":"kk","words":[["мағына","Бұл сөздің мағынасы қандай?",null],["жоғары оқу орны","Университетке қабылдандым.",null],["хайуанаттар бағы","Хайуанаттар бағында арыстан көрдім.",null],["пальто","Пальтоңызды киіңізші.",null],["таң алдындағы уақыт","Таң алдында тұрдым.",null],["ойын","Ойын ойнаймын.",null],["тауық еті","Тауық етінде май аз.",null],["жоғалту","Кілтті жоғалттым.",null],["бұршақ","Күрішке бұршақ қостым.",null],["гитара","Гитара тартамын.",null],["қабір","Тауда ескі қабір бар.",null],["суда пісіру","Жұмыртқа пісіремін.",null],["алғыс","Алғыс айттым.",null],["әмбебап дүкен","Әмбебап дүкеннен киім сатып алдым.",null],["біз, кішіпейілдікпен","Біз сізге көмектесеміз.",null],["қыздың үлкен әпкесі","Әпкем — университет студенті.","Әйелдің апасын атайтын сөзі; дәл сол адам туралы ер адам 누나 дейді. Әйелдер өздерінен сәл үлкен, жақын жүрген әйелге де осылай қаратып сөйлейді, дүкендерде де."],["қойылым","Қойылым басталады.",null],["сабын","Қолымды сабынмен жуамын.",null],["сұрау","Мұғалімнен сұрадым.",null],["олар","Олар дос.",null],["жауап реакциясы","Адамдардың реакциясы өте жақсы болды.",null],["былғары аяқ киім","Аяқ киім ыңғайлы.",null],["пошта","Поштадан хат жібердім.",null],["демалыс","Демалысқа шықтым.",null],["шақыру","Такси шақырамын.",null],["жылау","Нәресте жылап жатыр.",null],["диван","Диванға отырып демалыңыз.",null],["оқу","Күнде корей тілін оқимын.",null],["жаяу жүру","Саябақта жаяу жүремін.","듣다 сияқты ㄷ бұрыс етістігі: дауыстының алдында 걸어요, 걸었어요, дауыссыздың алдында 걷고, 걷습니다. 걸어요 сонымен қатар 걸다 (ілу, қоңырау шалу) етістігінің түрі: 전화를 걸어요 — қоңырау шалу, 공원을 걸어요 — саябақта серуендеу; толықтауыш шешеді. 걸음 (қадам) зат есімін де есте сақтаңыз."],["сол кезде","Сол кезде жаңбыр жауып тұрған.",null],["ондай","Ондай адам жоқ.",null],["хабарлама","Хабарлама алдым.",null],["матч","Матч жақында басталады.",null],["сары түс","Сары қолшатыр алдым.",null],["қуыршақ","Бала қуыршақты құшақтап тұр.",null],["қасық","Сорпаны қасықпен ішемін.",null],["ер адамның әпкесі","Әпкем ән айтып тұр.","Ер адамның әпкесіне қолданатын сөзі. Дәл сол адамға әйел 언니 дейді. 누나/언니 жұбы 형/오빠 сияқты жұмыс істейді: туыстық атаудың қайсысын қолданатыныңды сөйлеп тұрған адам шешеді."],["жануардың төлі","Мысықтың күшігі сүйкімді.","Жануардың төлі — мысық баласы 고양이 새끼. Адам туралы айтылса, ауыр балағат сөз және корей тіліндегі ең дөрекі сөздердің екінші жартысы. Оны тек жануарларға қалдырыңыз."],["шатыр","Шатыр қызыл.",null],["сенбі","Сенбіде кездесейік.",null],["бөтелке","Бос бөтелкені сыртқа шығарып тастадым.","Бөтелке. Дәл сол буын ауру дегенді де білдіреді, сондықтан 병이 있어요 бөтелке бар да, ауру бар да болуы мүмкін; 병에 걸렸어요 — 병 жұқтыру — әрқашан ауру."],["стақан","Бір стақан су беріңізші.",null],["көрініс","Сол көріністі әлі есімде.",null],["мұңды болу","Әңгіме мұңды.",null],["жақын жер","Жақын жерде дүкен бар.",null],["дайындалу","Емтиханға дайындалып жүрмін.",null],["жылан","Тау жолында жылан көрдім.",null],["құрал","Құралдарыңызды жақсы күтіңіз.",null],["жағдай","Жағдай жақсы емес.",null],["шет тілі","Шет тілін үйреніп жүрмін.",null],["сот залы","Ертең сот залына баруым керек.",null],["ойыншық","Ойыншық көп.",null],["қымбат болу","Бұл киім қымбат.",null],["байқау","Ән байқауына қатыстым.",null],["болмай қалу","Сабағым онша жүріп жатқан жоқ.",null],["анау","Анау не?",null],["көзді жұму","Көзіңізді жұмыңыз.",null],["солай","Солай істемеңізші.",null],["иіс","Жақсы иіс шығып тұр.",null],["жылдам болу","Пойыз жылдам.","다르다 сияқты 르 бұрыс сын есімі: 아/어 алдында 빨라요, 빨랐어요, ал 빠르고, 빠릅니다, 빠른 기차 (жылдам пойыз) дұрыс. Үстеуі — 빨리, тез: 빨리 오세요 — тез келіңіз; 빨리빨리 — асығуды білдіретін атақты корей сөзі. Антонимі — 느리다."],["қауіп","Апат қаупі жоғары.",null],["туннель","Пойыз туннельден өтті.",null],["тегін","Кіру тегін.",null],["бақытты болу","Мен қазір бақыттымын.",null],["өту","Уақыт тез өтеді.",null],["біреудің сөзі","Мұғалімнің сөзін тыңдадым.",null],["ыдысқа салу","Күрішті тәрелкеге саламын.",null],["жартысы","Алманы қақ бөлдім.","Жа
иться.",null],["так","Будь ласка, не робіть так.",null],["пустеля","У пустелі вдень дуже спекотно.",null],["вихід","Вихід он у той бік.",null],["заплющувати очі","Заплющте очі, будь ласка.",null],["це місце","Мені подобається це місце.",null],["чоло","На чолі виступив піт.",null],["брехня","Будь ласка, не брешіть.",null],["пісок","Біля моря багато піску.",null],["чимала часина","Я чекав чималу часину.",null],["червоний колір","Я купив червону сумку.",null],["бейсбол","Я дивлюся бейсбол.",null],["бути добрим, мати добре серце","Мій молодший брат дуже добрий.",null],["зуб","У цуценяти випав зуб.",null],["зовсім не","Я зовсім нічого не знав.",null],["кит","Кити дуже великі.",null],["телефонна розмова","Лінія зайнята.",null],["співати","Заспіваймо разом.",null],["запрошувати","Я запросив друга додому.",null],["маска","Я вдягнув маску.",null],["популярність","Ця пісня дуже популярна.",null],["вітати","Вітаю з днем народження.",null],["розмішувати","Я розмішав каву ложкою.",null],["завжди","Ти завжди спізнюєшся.",null],["подія","Сталася серйозна подія.",null],["команда","Ми працюємо разом у команді.",null],["рішення","Я ухвалив рішення.",null],["локшина швидкого приготування","Уночі я зварив собі локшину швидкого приготування.",null],["бали","Цього разу бали дуже зросли.",null],["підборіддя","Я сидів, підперши підборіддя рукою.",null],["реклама","Я бачив рекламу.",null],["керувати автомобілем","Кермуйте обережно, будь ласка.",null],["бити","Я б'ю по м'ячу.",null],["чоловік середнього віку","Пане, сюди, будь ласка!","Чоловік приблизно віку ваших батьків. Годиться, коли йдеться про незнайомого чоловіка; ризиковано як звертання, бо той, хто не вважає себе людиною середнього віку, може образитися. 저기요 підходить будь-кому."],["часто","Ми часто спілкуємося.",null],["смажена курка","Я замовив смажену курку.",null],["бути швидким","Потяг швидкий.",null],["бути смачним","Кімчі смачне.",null],["день тижня","Який сьогодні день тижня?",null],["п'ятниця","У п'ятницю іспит.",null],["кл
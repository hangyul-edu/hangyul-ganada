te se prosím telefonování.",null],["být správný, být řádný","Seďte prosím se správným držením těla.",null],["čím víc, tím líp","U informací platí: čím víc, tím líp.","Doslova „mnoho, mnoho: čím víc, tím lépe“. O tom, čeho není nikdy dost: informací, pomocných rukou, cviku."],["fakticky, v praxi","Fakticky je to u konce.",null],["násobit","Vynásobil jsem tři čtyřmi.",null],["utěšit, konejšit","Konejším plačící dítě.",null],["držet se za ruce","Jdu s dítětem za ruku.",null],["svěřit se","Svěřil jsem se se svými starostmi.",null],["vyvěsit","Vyvěsili vývěsní štít.",null],["ničit","Neničte prosím přírodu.",null],["popírat","Popírali skutečnost.",null],["zetlít, rozložit se","Dřevo zetlelo.",null],["budit lítost","Ztracený pes budí lítost.",null],["páchnout","Páchne to.",null],["být slabošský","Odhodil jsem slabošské myšlenky.",null],["dostat na krk","Ta práce zůstala celá na mně.",null],["odstranit","Odstranil jsem skvrnu.",null],["opakovat si pro sebe","Několikrát jsem si to jméno opakoval pro sebe.",null],["být hbitý","Pohybuje se hbitě.",null],["čeho je moc, toho je příliš","I s cvičením se to nemá přehánět.","Doslova „přejít není dojít“. Přehnat něco je stejná chyba jako neudělat dost. Pochází z Konfuciových Hovorů a dodnes je to běžná řeč."],["vynechat","Při čtení jsem vynechal jeden řádek.",null],["vzít v úvahu","Vzal jsem v úvahu počasí.",null],["úplná rezignace na sebe","Nelamte nad sebou hůl.",null],["zdědit","Zdědil jsem babiččin prsten.",null],["zisk třetího ze sporu dvou","Zatímco se ty dvě firmy přely, my jsme z toho vytěžili.",null],["popřít","Popřeli obvinění.",null]]}

tidak punya jam.",null],["malam","Banyak bintang di malam hari.","Malam. Ditulis sama dengan kata untuk buah berangan, camilan musim gugur yang lazim di Korea, sehingga 밤을 먹어요 dan 밤에 자요 membicarakan hal yang sangat berbeda."],["ujian","Besok saya ada ujian.",null],["komputer","Saya menyalakan komputer.",null],["cuaca","Cuacanya bagus.",null],["kertas","Saya menggambar di kertas.",null],["kota","Kotanya sangat besar.",null],["bagian atas","Ada topi di atas tas.",null],["masalah","Ada masalah.",null],["musim semi","Bunga bermekaran di musim semi.",null],["makan malam","Saya makan malam.",null],["musim dingin","Salju turun banyak di musim dingin.",null],["ayah","Ayah saya pergi bekerja.",null],["silakan, mari masuk","Selamat datang, silakan masuk.",null],["tinggal, hidup","Saya tinggal di Seoul.",null],["tidak bisa meski ingin","Terlalu pedas sampai saya tidak bisa memakannya.","Bahasa Korea punya dua bentuk pengingkaran dan keduanya berbeda maksud. 안 berarti *saya tidak mau*; 못 berarti *saya tidak bisa*. 안 먹어요 berarti Anda memilih tidak makan; 못 먹어요 berarti ada yang menghalangi. Kata benda dengan ejaan sama, 못, berarti paku."],["anak","Anak itu tertawa.",null],["makan siang","Mari makan siang bersama.",null],["siapa","Siapa orang itu?",null],["lagi","Tolong ulangi lagi.",null],["kapan","Kapan kamu datang?",null],["jalan","Banyak orang di jalan.",null],["kadang-kadang","Kadang-kadang saya menonton film.",null],["halo sekaligus selamat tinggal","Sampai jumpa lagi!",null],["banyak","Orangnya banyak.",null],["rok","Rok ini sangat cantik.",null],["kursi","Saya duduk di kursi.",null],["di sana","Di sana ada sekolah.",null],["taman","Saya berjalan-jalan di taman.",null],["beras","Saya mencuci beras lalu menanaknya.",null],["Bumi","Bumi itu bulat.",null],["di mana","Di mana toiletnya?",null],["dinding","Saya menggantung lukisan di dinding.",null],["telur","Pagi ini saya merebus telur.",null],["naik kendaraan","Saya naik bus.","Naik ke apa pun yang membawa Anda — bus, sepeda, lift. Dua kata kerja lain yang sangat umum memakai ejaan yang sama: 타다 juga berarti terbakar, dan melarutkan sesuatu ke dalam minuman."],["dunia","Saya tahu banyak negara di dunia.",null],["nama","Siapa namamu?",null],["sup","Pagi hari saya makan sup.",null],["berbicara","Tolong bicara pelan-pelan.",null],["berjalan","Saya berjalan di taman.",null],["anak anjing","Anak anjing itu kecil.",null],["sisi, samping","Silakan duduk di sebelah saya.",null],["suara","Suaranya keras.",null],["pikiran","Itu ide yang bagus.",null],["di situ","Apakah ada orang di situ?",null],["anak laki-laki","Anak laki-laki saya bersekolah.",null],["kafe","Saya bertemu teman di kafe.",null],["desa","Desanya tenang.",null],["bola","Saya menendang bola.",null],["menjadi","Saya ingin menjadi dokter.","Menjadi. Ia juga kata sehari-hari untuk sesuatu yang berfungsi atau diperbolehkan: 안 돼요 berarti itu tidak boleh, dan 다 됐어요 berarti sudah selesai. Keduanya jauh lebih sering Anda dengar daripada makna kamusnya."],["keluarga","Keluarga saya besar.",null],["sebutan sopan setelah nama","Minsu, sebentar.","Dilekatkan pada nama depan, ia sopan dan akrab di antara sesama: 민수 씨. Dilekatkan pada nama keluarga saja — 김 씨 — terdengar berjarak bahkan ketus, jadi pakailah nama depan. Kepada atasan, pakai gelarnya: 부장님, 선생님."],["pagi","Saya bangun pagi.",null],["menelepon","Saya akan meneleponmu nanti.",null],["musim gugur","Angin sejuk di musim gugur.",null],["bunga","Bunganya cantik.",null],["peta","Saya melihat peta.",null],["warna","Warna ini bagus.",null],["meja belajar","Ada buku di atas meja.",null],["sayur","Makanlah banyak sayur.",null],["memberi","Saya memberi hadiah.",null],["pertama kali","Senang berkenalan dengan Anda.",null],["buah","Saya suka buah.",null],["dokter","Dokter memeriksa saya.",null],["halo, di telepon","Halo, ini siapa?",null],["anak perempuan","Anak perempuan saya bersekolah.",null],["sapi","Sapi itu makan rumput.",null],["surat","Saya menulis surat untuk ibu.",null],["sedikit","Sedikit saja.",null],["tempat duduk","Tidak ada tempat duduk.",null],["terlihat","Gunung itu terlihat.",null],["sesudah","Setelah kelas saya pergi ke perpustakaan.",null],["kartu","Saya akan membayar dengan kartu.",null],["besok","Sampai jumpa besok.",null],["penting","Kesehatan adalah yang terpenting.",null],["telur","Pagi hari saya makan telur.",null],["Korea","Saya suka masakan Korea.",null],["sangat","Ini sangat enak.",null],["benar","Jawaban ini benar.",null],["sungai","Sungainya sangat lebar.",null],["detik","Tinggal tiga puluh detik.",null],["perusahaan, kantor","Saya pergi ke kantor.",null],["kabar dari seseorang","Saya punya kabar baik.",null],["kecil","Sepatunya kecil.",null],["kimchi","Kimchinya pedas.",null],["membaca","Saya membaca koran.",null],["dan, lalu","Saya membeli roti. Dan saya juga membeli susu.",null],["besar","Tas ini besar.",null],["kontak, kabar","Tolong hubungi saya nanti.",null],["bersama","Mari makan bersama.",null],["terlalu","Baju ini terlalu besar.",null],["naga","Ada naga besar di lukisan itu.",null],["hotel","Saya menginap di hotel.",null],["kunci","Saya tidak punya kunci.",null],["begitu","Ya, begitulah.",null],["cantik","Bunganya benar-benar cantik.",null],["itu","Tolong berikan yang itu.",null],["berikutnya","Sampai jumpa lain kali.",null],["hati","Hatinya hangat.",null],["mobil","Mobilnya cepat.",null],["mati","Bunga di pot itu mati karena tidak disiram.",null],["terbang","Burung terbang di langit.",null],["makan, santapan","Makanannya sangat enak.",null],["mesin","Mesinnya rusak.",null],["tanah","Tanahnya basah.",null],["tidur","Saya tidur lebih awal.",null],["membuang","Tolong buang ke tempat sampah.",null],["alamat","Tolong beri tahu alamatnya.",null],["kereta api","Keretanya sudah berangkat.",null],["sikat gigi","Saya membeli sikat gigi baru.",null],["cinta","Cinta itu indah.",null],["belajar","Belajar itu menyenangkan.",null],["ikan sebagai makanan","Saya menggoreng ikan untuk makan malam.",null],["leher","Leher saya sakit.",nu
ού","Πού είναι η τουαλέτα;",null],["τοίχος","Κρεμάω έναν πίνακα στον τοίχο.",null],["αυγό","Το πρωί έβρασα ένα αυγό.",null],["επιβιβάζομαι, πηγαίνω με","Παίρνω το λεωφορείο.",null],["ο κόσμος","Ξέρω πολλές χώρες του κόσμου.",null],["όνομα","Πώς σε λένε;",null],["σούπα","Το πρωί τρώω σούπα.",null],["μιλάω","Μιλήστε αργά, παρακαλώ.",null],["περπατάω","Περπατάω στο πάρκο.",null],["κουτάβι","Το κουτάβι είναι μικρό.",null],["ήχος","Ο ήχος είναι δυνατός.",null],["η πλευρά","Καθίστε δίπλα μου, παρακαλώ.",null],["σκέψη","Είναι καλή ιδέα.",null],["εκεί","Είναι κανείς εκεί;",null],["γιος","Ο γιος μου πηγαίνει σχολείο.",null],["γίνομαι","Θέλω να γίνω γιατρός.",null],["χωριό","Το χωριό είναι ήσυχο.",null],["καφετέρια","Συναντώ τον φίλο μου στην καφετέρια.",null],["μπάλα","Κλωτσάω τη μπάλα.",null],["οικογένεια","Έχω μεγάλη οικογένεια.",null],["κύριε ή κυρία, μετά από όνομα","Μινσού, μια στιγμή.",null],["πρωί","Ξυπνάω το πρωί.",null],["τηλεφωνώ","Θα σε πάρω τηλέφωνο αργότερα.",null],["φθινόπωρο","Το φθινόπωρο ο αέρας είναι δροσερός.",null],["λουλούδι","Το λουλούδι είναι όμορφο.",null],["χάρτης","Κοιτάζω τον χάρτη.",null],["χρώμα","Αυτό το χρώμα είναι όμορφο.",null],["δίνω","Δίνω ένα δώρο.",null],["λαχανικά","Τρώτε πολλά λαχανικά, παρακαλώ.",null],["γραφείο","Πάνω στο γραφείο υπάρχει ένα βιβλίο.",null],["η πρώτη φορά","Χαίρω πολύ για τη γνωριμία.",null],["φρούτα","Μου αρέσουν τα φρούτα.",null],["γιατρός","Ο γιατρός με εξετάζει.",null],["κόρη","Η κόρη μου πηγαίνει σχολείο.",null],["εμπρός, στο τηλέφωνο","Εμπρός, ποιος είναι;",null],["αγελάδα","Η αγελάδα τρώει χορτάρι.",null],["γράμμα","Γράφω ένα γράμμα στη μητέρα μου.",null],["λίγο","Μόνο λίγο, παρακαλώ.",null],["φαίνομαι","Φαίνεται το βουνό.",null],["θέση","Δεν υπάρχουν θέσεις.",null],["μετά","Μετά το μάθημα πηγαίνω στη βιβλιοθήκη.",null],["κάρτα","Θα πληρώσω με κάρτα.",null],["αύριο","Τα λέμε αύριο.",null],["είμαι σημαντικός","Η υγεία είναι το πιο σημαντικό.",null],["αυγό","Το πρωί τρώω ένα αυγό.",null],["πολύ","Είναι πολύ νόστιμ
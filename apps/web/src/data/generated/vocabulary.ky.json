{"locale":"ky","words":[null,["кылуу","Мен сабак окуйм.","Кылуу — жана корей сөз жасоонун кыймылдаткычы. Аны зат атоочко кошсоңуз, этиш чыгат: 공부 (окуу) → 공부하다 (окуу, билим алуу), 사랑 (сүйүү) → 사랑하다. Жүздөгөн этиш ушинтип жасалган."],["унаа","Мен унаа менен барам.","Унаа. Ушул эле муун чай дегенди да билдирет: 차를 마셔요 — чай ичем, 차를 타요 — унаага отурам. Кайсынысы экенин этиш айтат."],["аял","Ал аял — дарыгер.",null],["акча","Капчыкта акча бар.",null],["бир жерде болуу","Мен үйдөмүн.","Кыргызчада эки сөз керек жерде корейчеде бирөө: 있다 — бир жерде болуу да, ээ болуу да. 책상에 책이 있어요 — китеп үстөлдө турат; 시간이 있어요 — убактым бар. Тескериси — 없다."],null,["мен","Мен корей тилин үйрөнүп жатам.",null],["биз","Биз досбуз.",null],["Күн","Күн жаркырап турат.",null],["үй","Мен үйгө бара жатам.",null],["кол","Мен кол менен жазам.",null],["убакыт","Менин убактым жок.","Жалпы убакыт, ошондой эле сааттарды сануучу сөз: 두 시간 — эки саат. Аны 시 менен чаташтырбаңыз, ал — сааттагы убакыт: 두 시 — саат экиде, таптакыр башка нерсе."],["ооба","Ооба, туура.","네 деп жазылган үч кеңири сөз бар. Бул — «ооба». Калгандары «сенин» (네 책, сенин китебиң) жана эсептик сөздүн алдында турган «төрт» (네 개, төрт даана). Аларды жазылышы эмес, контекст ажыратат."],["ит","Ит чуркап баратат.",null],["куш","Куш учуп баратат.",null],["эшик","Мен эшикти ачам.",null],null,["дене","Мен күн сайын денемди жуум.",null],["бөлмө","Бөлмө таза.",null],null,["көз","Сенин көздөрүң сулуу.","Көз. Кар деген сөз менен бирдей жазылат; кылдат сүйлөгөндө аларды узундугу айырмалайт: кардын 눈-у созулуп, көздүн 눈-у кыска айтылат. Көпчүлүк контекстке таянат."],["кийим","Кийим сулуу.",null],["баруу","Мен мектепке барам.",null],["баш","Башым ооруп жатат.",null],["жамгыр","Жамгыр жаап жатат.",null],["ооз","Ооз кичинекей.",null],["суу","Мен суу ичем.",null],["бут","Бутум ооруйт.","Бут — сиздики, үстөлдүкү, отургучтуку. Ушул эле сөз «көпүрө» дегенди да билдирет, ошондуктан 다리를 건너요 — «көпүрөдөн өтөм», денеге тиешеси жок."],["мектеп","Мектеп чоң.",null],["бет","Мен бетимди жуум.",null],null,["сен","Сен кайдасың?",null],["жок болуу","Менде акча жок.",null],["мен (сылык)","Мен студентмин.",null],["кол","Сенин колдоруң узун.",null],null,["ыр","Мен ыр ырдайм.",null],["китеп","Мен китеп окуйм.",null],["Ай","Ай жарык.",null],["телефон","Мен телефонго жооп берем.",null],["дарак","Дарак бийик.",null],["көрүү","Мен кино көрөм.",null],["бир күн","Күн узун.",null],["адам","Ал жакшы адам.",null],["бул жерде","Бул жерге отуруңуз.",null],["эмнеге","Эмнеге кечиктиң?",null],["дүйнө","Дүйнө кенен.",null],null,["кечигүү","Автобус кечикти.",null],["таман","Бутум тоңуп калды.",null],["күн","Бүгүн жакшы күн.",null],["мурун","Мурдум бүтөлүп калды.",null],["сүрөт","Мен сүрөт тартам.",null],["керебет","Керебет ыңгайлуу.",null],["тоо","Мен тоого барам.",null],null,["азыр","Мен азыр барам.",null],["белек","Мага белек жагат.",null],["ооруқана","Мен ооруканага барам.",null],["баары","Баары чогулду.",null],["сумка","Сумка оор.",null],["музыка","Музыка сонун.",null],null,["бир","Бир алма бериңизчи.",null],["түштөн кийин","Түштөн кийин жолугалы.",null],["дүкөн","Дүкөн жабык.",null],null,["жол","Жол кең.",null],["кулак","Кулагым ооруйт.",null],["кофе","Мен кофе ичем.",null],["тамак","Мен тамак ичем.",null],["автобус","Автобус келе жатат.",null],["сүрөт","Мен сүрөт тартам.",null],["бүгүн","Бүгүн аба ырайы жакшы.",null],["чын эле","Чоң рахмат.","Чын эле, чынында — сын атоочтун алдында турган күчөтүүчү сөз: 정말 좋아요. Жалгыз турганда, аягын көтөрүп айтса, 정말? бир сөздүк суроо болот: «чынбы?» — көбүнчө ушинтип угасыз."],["арак","Мен арак ичпейм.",null],["кино","Кино кызык.",null],["жолу","Дагы бир жолу кылыңызчы.",null],["келүү","Досум келе жатат.",null],["учак","Мен учак менен учам.",null],["жылдыз","Жылдыздар жаркырап турат.",null],["сатып алуу","Мен нан сатып алам.",null],null,["апам","Апам тамак жасап жатат.",null],null,["эт","Мен эт куурам.",null],["сырт","Сыртта жамгыр жаап жатат.",null],["алма","Алма таттуу.",null],["деңиз","Деңиз кең.",n
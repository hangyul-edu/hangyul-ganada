,null],["мобільний телефон","Я заряджаю телефон.",null],["гаманець","Я загубив гаманець.",null],["мобільний телефон","Я загубив телефон.",null],["молода жінка","Молода жінка запитує дорогу.","Молода незаміжня жінка — але як *звертання* до незнайомки слово зіпсувалося, і багато жінок вважають його нечемним або принизливим. Кажіть так про когось, а не комусь; щоб привернути увагу незнайомої людини, скажіть 저기요."],["пам'ять","Я не пам'ятаю.",null],["одягати","Я одягаюся.",null],["проводити лінію","Я провів лінію.",null],["проміжок між","Між двома будинками росте дерево.",null],["олія","Я смажу це на олії.",null],["риба","Риба пливе.",null],["слово для лічби аркушів","Мені потрібні три аркуші паперу.",null],["починати","Заняття починається.",null],["досі","Я досі чекаю.",null],["вантажівка","Проїжджає вантажівка.",null],["сон","Учора вночі мені наснився дивний сон.",null],["почерк","У тебе гарний почерк.",null],["який","Який колір тобі подобається?",null],["слухати, чути","Я слухаю музику.",null],["кавун","Улітку кавун смачний.",null],["полуниця","Я мию полуницю і їм.",null],["село","У селі гарне повітря.",null],["розв'язувати","Я розв'язав задачу.",null],["вітер","Вітер прохолодний.",null],["окуляри","Я ношу окуляри.",null],["олівець","Я малюю олівцем.",null],["вихідні","На вихідних я відпочиваю.",null],["убивати","Я вбив комара, що залетів у кімнату.",null],["сила","Та дитина дуже сильна.",null],["усе разом","Скільки всього?",null],["поліція","Викличте, будь ласка, поліцію.",null],["миска","Я накладаю рис у миску.",null],["бути поганим","Погода погана.",null],["старший брат жінки","Мій старший брат за кермом.","Корейська обирає слово для брата за статтю мовця: жінка кличе старшого брата 오빠, чоловік — 형. Так само звертаються до старшого чоловіка, з яким жінка близька, і тому слово чути далеко за межами родини."],["надія","Не втрачайте, будь ласка, надії.",null],["зустрічатися","Ми часто зустрічаємось.",null],["старший брат чоловіка","Старший брат пригостив мене їжею.",
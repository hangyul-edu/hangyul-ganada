node_modules/
dist/
build/
coverage/
*.log

# Local databases. There is no longer one in this product; the pattern stays so
# a stray scratch database from tooling never lands in a commit.
*.db
*.db-journal

# Python
__pycache__/
*.py[cod]
.mypy_cache/
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Env / secrets
.env
.env.local
.env.*.local

# Playwright
test-results/
playwright-report/
blob-report/
.playwright/

# Design source material (large binaries, not distributed)
*.pdf
.design-audit/
.visual-qa/

# The content pipeline's download cache. Disposable — the built dataset, the
# illustrations and the audio are committed; what they were built from is not.
content-cache/
.tts-venv/
.stroke-qa/

# Every screen in every language, written by `npm run qa:locales`. 256 renders
# and a contact sheet — regenerated on demand, not a source of truth.
.locale-qa/

# Windows download-provenance stubs (NTFS alternate data streams). Five of
# these are tracked from the initial import under a legacy name; new ones
# appear whenever the brand PNGs are copied in from Windows and are not part
# of the product.
*Zone.Identifier
.walk-shots/

# The letter/face comparison sheet, written by `npm run letters:face`. Every
# letter at three sizes against the font file — regenerated on demand, and the
# JSON beside it is a measurement, not a source of truth.
.letter-face-qa/
.cv-audit/

# The conjugation display ledger, rewritten by conjugation:display:qa on
# every run. A reading surface, not a source of truth.
.conjugation-display/

*:Zone.Identifier

# The technical disclosure package prepared for patent counsel. Marked
# "Not for publication" and this remote is public — it stays on disk only.
patent/

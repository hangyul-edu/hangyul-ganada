<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!--
      Permissions.

      INTERNET only, and it is a normal (non-dangerous) permission the user is
      never asked about. Capacitor's WebView bridge needs it to serve the
      bundled app over its internal https origin; nothing in the app makes a
      network request, and the release binary has been audited for it.

      POST_NOTIFICATIONS is the daily study reminder, and it is the only
      permission the learner is ever prompted for. Declaring it here does not
      ask for it: on Android 13 and later the prompt is shown when the app calls
      for it, and this app calls for it at exactly one moment — the learner has
      turned the reminder on in Settings and picked a time. See
      `apps/web/src/native/reminder.ts`. With the reminder off, which is the
      default, no prompt is ever shown and nothing is ever scheduled.

      Deliberately NOT requested, because no implemented feature needs them:
      location, contacts, microphone, camera, phone, SMS, storage.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Two normal permissions that arrive with `@capacitor/local-notifications`
      and are kept, because the reminder is broken without them: an alarm is
      dropped by the system on reboot unless the app can re-register it, and
      WAKE_LOCK is how the notification is delivered on a sleeping device.
      Neither is prompted for.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      And one that arrives with it and is removed.

      `SCHEDULE_EXACT_ALARM` is a *restricted* permission: Google Play grants it
      to alarm-clock and calendar apps and asks everyone else to justify it, and
      "a study reminder that arrives at 19:00 rather than 19:00:00" is not a
      justification. The plugin declares it because some of its scheduling modes
      need it; the mode this app uses does not. `reminder.ts` schedules with
      `on: {hour, minute}, repeats: true` and no `allowWhileIdle`, which reaches
      `AlarmManager.set()` — inexact, and permitted without this.

      Removed at the merger rather than by patching the dependency, so upgrading
      the plugin cannot quietly reintroduce it. `scripts/audit-release-security.mjs`
      fails the build if it appears in a packaged APK.
    -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:node="remove" />

    <!--
      A touchscreen is how you write Hangul, but not having a stylus or a
      multi-touch panel is no reason to hide the app from a device.
    -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!--
      `android:screenOrientation="portrait"` above makes the build tools infer a
      *required* portrait feature, which would hide the app from Chromebooks and
      from tablets that report only landscape. Declaring it not-required undoes
      that inference. The activity still prefers portrait on a phone; large
      screens ignore the request entirely from Android 16 onwards, which is the
      behaviour we want on a tablet anyway.
    -->
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      The theme the Activity runs under once the app is up.

      DayNight rather than Light: the app follows the system, and a hard-coded
      Light parent makes the window flash white behind the WebView on a phone in
      dark mode during a rotation or a configuration change.
    -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="android:background">@null</item>
    </style>

    <!--
      The launch theme.

      Android 12 and newer always draw their own splash screen; an app cannot
      opt out, and drawing a second one on top is the flicker every "why does my
      app blink" bug report is about. So this hands the system what it needs and
      nothing more:

      * `windowSplashScreenBackground` — the app's warm ground, matching the
        launcher tile the icon just animated out of.
      * `windowSplashScreenAnimatedIcon` — the splash artwork's own mark.

        This used to be left unset, on the reasoning that the launcher icon is
        already drawn inside the safe circle and already sits on this colour.
        On a real device that produced three screens: the mandarin launcher
        tile, then the app's splash with the jamo mark, then the app. Two
        different marks one after the other is what makes a single splash read
        as two, and it is what the launcher-icon-first report was about.

        The system frame now carries the mark the splash carries, so a cold
        start is the ground, then the mark, then the wordmark resolving on top
        of it. `mipmap/splash_icon` is generated beside the launcher icons from
        the same source and on the same adaptive canvas, so the two cannot drift
        apart in size — which is the thing the old note was worried about.
      * `postSplashScreenTheme` — what the Activity becomes once the splash is
        dismissed.

      `android:windowBackground` is the pre-Android-12 path, where there is no
      system splash and the window background *is* the splash.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splashBackground</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/splash_icon</item>
        <!-- Still, not animated: there is nothing to animate and a duration
             here only delays the app behind a mark that is not moving. -->
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowBackground">@drawable/splash</item>
    </style>
</resources>

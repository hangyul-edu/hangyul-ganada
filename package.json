{
  "name": "hangyul-ganada",
  "private": true,
  "version": "0.1.0",
  "description": "Hangyul ganada — a Hangul letter-learning and handwriting practice app for Korean learners worldwide.",
  "workspaces": [
    "packages/*",
    "apps/web",
    "apps/mobile"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace @hangyul-ganada/web",
    "dev:lan": "node scripts/serve-lan.mjs dev",
    "preview:lan": "node scripts/serve-lan.mjs preview",
    "claude:resilient": "bash scripts/claude-resilient.sh",
    "claude:status": "bash scripts/claude-resilient.sh --status",
    "build": "npm run build --workspace @hangyul-ganada/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace @hangyul-ganada/web",
    "tokens:build": "node packages/design-tokens/scripts/build-css.mjs",
    "tokens:check": "node packages/design-tokens/scripts/build-css.mjs --check",
    "curriculum:build": "tsx scripts/export-curriculum.mjs",
    "curriculum:check": "tsx scripts/export-curriculum.mjs --check",
    "strokes:qa": "tsx scripts/strokes-qa.mjs",
    "strokes:qa:check": "tsx scripts/strokes-qa.mjs --check",
    "vocabulary:qa": "tsx scripts/vocabulary-qa.mjs",
    "vocabulary:qa:check": "tsx scripts/vocabulary-qa.mjs --check",
    "vocabulary:qa:target": "tsx scripts/vocabulary-qa.mjs --check --target",
    "strokes:build": "tsx scripts/build-stroke-assets.mjs",
    "strokes:build:check": "tsx scripts/build-stroke-assets.mjs --check",
    "strokes:measure": "tsx scripts/measure-composition.mjs",
    "fonts:audit": "python3 scripts/content/audit_fonts.py",
    "i18n:report": "node scripts/i18n-report.mjs",
    "i18n:check": "node scripts/i18n-report.mjs --check",
    "name:check": "node scripts/check-product-name.mjs --check",
    "qa:i18n": "npm run qa:i18n --workspace @hangyul-ganada/web",
    "verify:quick": "npm run name:check && npm run i18n:check && npm run copy:audit:check && npm run strokes:qa:check && npm run vocabulary:qa:check && npm run tokens:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run bundle:budget:check && npm run routing:check",
    "verify:release": "npm run verify:quick && npm run store:check && npm run curriculum:check && npm run fonts:audit && npm run mobile:icons:check && npm run vocabulary:qa:target && npm run content:vocabulary:check && npm run content:qa:check && npm run examples:qa:check && npm run audio:pronunciation:check && npm run content:coverage:check && npm run docs:consistency:check",
    "verify": "npm run verify:release",
    "content:fetch": "python3 scripts/content/fetch_dictionary.py",
    "content:vocabulary": "python3 scripts/content/build_vocabulary.py",
    "content:vocabulary:check": "python3 scripts/content/build_vocabulary.py --check",
    "audio:plan": "tsx scripts/export-speech-plan.mjs",
    "audio:build": "python3 scripts/content/generate_audio.py",
    "audio:qa": "python3 scripts/content/qa_audio.py",
    "audio:pronunciation": "python3 scripts/content/qa_pronunciation.py",
    "audio:pronunciation:check": "python3 scripts/content/qa_pronunciation.py --check",
    "audio:listen": "python3 scripts/content/qa_pronunciation.py --listen --kind word --json content-cache/listen/words.json",
    "audio:listen:fixtures": "python3 scripts/content/qa_pronunciation.py --fixtures --kind word,sentence --check",
    "docs:shots": "node scripts/capture-report-shots.mjs",
    "docs:report": "node scripts/build-report.mjs",
    "docs:consistency": "node scripts/check-docs-consistency.mjs",
    "docs:consistency:check": "node scripts/check-docs-consistency.mjs --check",
    "fonts:audit:strict": "python3 scripts/content/audit_fonts.py --strict",
    "mobile:icons": "python3 scripts/content/build_app_icons.py",
    "mobile:icons:check": "python3 scripts/content/build_app_icons.py --check",
    "mobile:sync": "npm run build --workspace @hangyul-ganada/web && npx --workspace @hangyul-ganada/mobile cap sync",
    "mobile:audit:libs": "node scripts/audit-native-libs.mjs",
    "mobile:qa": "node scripts/qa-native-android.mjs",
    "mobile:qa:safe-area": "node scripts/qa-safe-area-android.mjs",
    "content:coverage": "python3 scripts/content/report_coverage.py",
    "content:coverage:check": "python3 scripts/content/report_coverage.py --check",
    "examples:qa": "python3 scripts/content/examples_qa.py",
    "examples:qa:check": "python3 scripts/content/examples_qa.py --check",
    "content:qa": "python3 scripts/content/qa_pack.py",
    "content:qa:check": "python3 scripts/content/qa_pack.py --check",
    "content:build": "npm run content:vocabulary",
    "review:benchmark": "tsx scripts/review-benchmark.mts",
    "handwriting:robustness": "tsx packages/handwriting-core/scripts/robustness-report.mts",
    "bundle:budget": "node scripts/check-bundle-budget.mjs",
    "bundle:budget:check": "node scripts/check-bundle-budget.mjs --check",
    "routing:check": "node scripts/check-spa-routing.mjs --check",
    "routing": "node scripts/check-spa-routing.mjs",
    "copy:audit": "node scripts/audit-copy.mjs",
    "copy:audit:check": "node scripts/audit-copy.mjs --check",
    "store:shots": "node scripts/capture-store-shots.mjs",
    "store:check": "node scripts/check-store-listing.mjs --check",
    "result:build": "node scripts/build-result.mjs",
    "security:audit": "node scripts/audit-release-security.mjs"
  },
  "devDependencies": {
    "marked": "^18.0.9",
    "qrcode-terminal": "^0.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}

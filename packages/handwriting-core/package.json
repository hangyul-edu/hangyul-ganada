{
  "name": "@hangyul-ganada/handwriting-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Platform-independent handwriting geometry comparison for Hangyul ganada.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "calibrate": "tsx scripts/calibrate.mjs",
    "calibrate:glyphs": "tsx scripts/calibrate-glyphs.mjs",
    "fixtures": "python3 scripts/render-fixtures.py"
  },
  "devDependencies": {
    "vitest": "^3.0.5",
    "tsx": "^4.19.2"
  }
}
